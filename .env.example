# BE2OSM Docker Deployment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_USER=be2osm
POSTGRES_PASSWORD=<CHANGE_ME_generate_secure_password>
POSTGRES_DB=be2osm

# =============================================================================
# DOMAIN CONFIGURATION
# =============================================================================
# Your domain name (use 'localhost' for local development)
DOMAIN=your-domain.com

# =============================================================================
# OSM OAUTH 2.0 CONFIGURATION
# =============================================================================
# Register your application at: https://www.openstreetmap.org/oauth2/applications
OSM_CLIENT_ID=your_osm_client_id_here
OSM_CLIENT_SECRET=your_osm_client_secret_here
OSM_REDIRECT_URI=https://your-domain.com/api/auth/osm-callback

# =============================================================================
# GEOFABRIK OSM DATA
# =============================================================================
# OSM region to download and update
# Options: europe/belgium, europe/belgium/brussels, etc.
# See: https://download.geofabrik.de/
OSM_REGION=europe/belgium

# =============================================================================
# DIGITAL VLAANDEREN API (for GRB data import)
# =============================================================================
# Register for API key at: https://api.vlaanderen.be/
DIGITAL_VLAANDEREN_API_KEY=your_api_key_here
DIGITAL_VLAANDEREN_API_BASE_URL=https://api.vlaanderen.be/gebouwenregister/v2

# Database configuration for processing tools
DB_HOST=localhost
DB_PORT=15432
DB_USER=brunomoyse
DB_PASSWORD=your_database_password

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================
# Timezone for cron jobs (default: Europe/Brussels)
TZ=Europe/Brussels

# Node environment (default: production)
NODE_ENV=production

# =============================================================================
# DEVELOPMENT ONLY
# =============================================================================
# Uncomment for development with local domain
# DOMAIN=localhost
# OSM_REDIRECT_URI=http://localhost/api/auth/osm-callback
