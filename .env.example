# BE2OSM Docker Deployment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# For production: use 'postgres' (the container name)
# For local dev with host DB: use 'host.docker.internal'
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=be2osm
POSTGRES_PASSWORD=be2osm
POSTGRES_DB=be2osm

# =============================================================================
# DOMAIN CONFIGURATION
# =============================================================================
# Your domain name (use 'localhost' for local development)
DOMAIN=localhost

# =============================================================================
# APPLICATION SECRETS
# =============================================================================
# JWT secret for API authentication (generate random 32+ character string)
JWT_SECRET=your-random-jwt-secret-here

# =============================================================================
# OSM OAUTH 2.0 CONFIGURATION
# =============================================================================
# Register your application at: https://www.openstreetmap.org/oauth2/applications
OSM_CLIENT_ID=
OSM_CLIENT_SECRET=
OSM_REDIRECT_URI=https://your-domain.com/api/auth/osm-callback

# =============================================================================
# GEOFABRIK OSM DATA
# =============================================================================
# OSM region to download and update
# Options: europe/belgium, europe/belgium/brussels, etc.
# See: https://download.geofabrik.de/
OSM_REGION=europe/belgium

# Overpass API endpoint for the opt-in "Live OSM" difference mode (issue #9).
# Optional — defaults to the public instance. Override to use a self-hosted/mirror instance.
# OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# =============================================================================
# DIGITAL VLAANDEREN API
# =============================================================================
# Register for API key at: https://api.vlaanderen.be/
DIGITAL_VLAANDEREN_API_KEY=your_api_key_here
DIGITAL_VLAANDEREN_API_BASE_URL="https://download.api.vlaanderen.be/v2"

# =============================================================================
# DOCKER IMAGES AND COMPOSE PROJECT
# =============================================================================
# Production pins the images built by CI through their :deployed tags (webhook/deploy.sh); don't set
# NUXT_IMAGE / PROCESSING_IMAGE / WEBHOOK_IMAGE there. Locally, `docker compose build` builds them.
# scripts/server-bootstrap.sh sets these two on the server:
# COMPOSE_PROJECT_NAME=buildings
# COMPOSE_PROJECT_DIR=/opt/docker/buildings

# =============================================================================
# WEBHOOK CONFIGURATION
# =============================================================================
# Secret shared between GitHub Actions and the webhook service
WEBHOOK_SECRET=your-random-webhook-secret-here

# GitHub token: classic PAT with "repo" (private checkout and artifacts) and "read:packages" (images)
GH_TOKEN=ghp_your_token_here

# GitHub repository in "owner/repo" format
GH_REPO=osmbe/building-import-tool

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================
# Timezone for cron jobs (default: Europe/Brussels)
TZ=Europe/Brussels

# Node environment (default: production)
NODE_ENV=production
