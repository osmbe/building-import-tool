{
	admin off
	# TLS is handled by Nginx Proxy Manager upstream; Caddy only needs HTTP
	auto_https off
}

:80 {
	encode zstd gzip

	# Logging
	log {
		output stdout
		format json
		level INFO
	}

	# Martin GRB, PICC, UrbIS Tiles
	handle /tiles/be2osm/* {
		uri strip_prefix /tiles/be2osm
		reverse_proxy be2osm-tiles:3000 {
			header_up X-Forwarded-Proto https
			header_up Host {host}
		}
	}

	# Martin OSM Tiles
	handle /tiles/osm/* {
		uri strip_prefix /tiles/osm
		reverse_proxy osm-tiles:3000 {
			header_up X-Forwarded-Proto https
			header_up Host {host}
		}
	}

	# Webhook service
	handle /webhook/* {
		uri strip_prefix /webhook
		reverse_proxy webhook:9000 {
			header_up X-Forwarded-Proto https
			header_up Host {host}
		}
	}

	# All other routes (including /api/*) go to Nuxt
	# Nuxt will handle proxying to Rust API where needed
	handle {
		reverse_proxy nuxt-app:3000 {
			header_up X-Forwarded-Proto https
			header_up Host {host}
		}
	}
}
