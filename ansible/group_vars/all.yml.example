---
# BE2OSM Configuration Variables
# Copy to all.yml and fill in your values
# IMPORTANT: Never commit all.yml with real secrets!

# =============================================================================
# DOMAIN CONFIGURATION
# =============================================================================
domain: be2osm.example.com

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
postgres_user: be2osm
postgres_password: "CHANGE_ME_STRONG_PASSWORD"
postgres_db: be2osm

# =============================================================================
# APPLICATION SECRETS
# =============================================================================
jwt_secret: "CHANGE_ME_RANDOM_32_CHAR_STRING"

# =============================================================================
# OSM OAUTH 2.0 CONFIGURATION
# =============================================================================
# Register at: https://www.openstreetmap.org/oauth2/applications
osm_client_id: "YOUR_OSM_CLIENT_ID"
osm_client_secret: "YOUR_OSM_CLIENT_SECRET"
osm_redirect_uri: "https://{{ domain }}/api/auth/osm-callback"

# =============================================================================
# DIGITAL VLAANDEREN API (Optional - for GRB imports)
# =============================================================================
digital_vlaanderen_api_key: ""

# =============================================================================
# DEPLOYMENT SETTINGS
# =============================================================================
# Application deployment directory
app_dir: /opt/be2osm

# Git repository (your fork or the main repo)
git_repo: "https://github.com/yourusername/be2osm.git"
git_branch: main

# Docker image (leave empty to build locally)
nuxt_image: ""

# =============================================================================
# SYSTEM SETTINGS
# =============================================================================
# Timezone
timezone: Europe/Brussels

# Create a non-root deploy user (recommended)
deploy_user: deploy
deploy_group: deploy

# SSH port (change if you've modified it)
ssh_port: 22

# =============================================================================
# OPTIONAL: FIREWALL SETTINGS
# =============================================================================
# Ports to open (besides SSH, HTTP, HTTPS)
# additional_ports: []
