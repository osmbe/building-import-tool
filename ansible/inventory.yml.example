---
# BE2OSM Ansible Inventory
# Copy to inventory.yml and configure your VPS details

all:
  children:
    be2osm:
      hosts:
        vps:
          ansible_host: YOUR_VPS_IP
          ansible_user: root
          # Or use a non-root user with sudo:
          # ansible_user: deploy
          # ansible_become: true
          # ansible_become_method: sudo

# For multiple environments, you can define:
# production:
#   hosts:
#     prod-server:
#       ansible_host: 1.2.3.4
#       ansible_user: deploy
#
# staging:
#   hosts:
#     staging-server:
#       ansible_host: 5.6.7.8
#       ansible_user: deploy
