# Minimal docker-compose for DO Processing VM
# Generated by Ansible

services:
  postgres:
    image: postgis/postgis:18-3.6
    container_name: be2osm-postgres
    environment:
      POSTGRES_USER: {{ postgres_user }}
      POSTGRES_PASSWORD: {{ postgres_password }}
      POSTGRES_DB: {{ postgres_db }}
    volumes:
      - postgres-data:/var/lib/postgresql/data
      - ./postgres/01-init-db.sql:/docker-entrypoint-initdb.d/01-init-db.sql:ro
      - ./postgres/02-setup-be2osm.sql:/docker-entrypoint-initdb.d/02-setup-be2osm.sql:ro
      - ./postgres/03-setup-osmbe.sql:/docker-entrypoint-initdb.d/03-setup-osmbe.sql:ro
      - ./postgres/04-setup-fdw.sql:/docker-entrypoint-initdb.d/04-setup-fdw.sql:ro
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ postgres_user }} -d {{ postgres_db }}"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks:
      - be2osm

  processing:
    build:
      context: ./processing
      dockerfile: Dockerfile
    container_name: be2osm-processing
    env_file:
      - .env
    volumes:
      - ./processing:/work:z
      - ./processing/data:/work/data:z
      - ./processing/logs:/work/logs:z
    depends_on:
      postgres:
        condition: service_healthy
    stdin_open: true
    tty: true
    networks:
      - be2osm

networks:
  be2osm:
    driver: bridge

volumes:
  postgres-data:
