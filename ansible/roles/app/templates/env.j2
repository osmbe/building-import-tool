# BE2OSM Environment Configuration
# Generated by Ansible - Do not edit manually

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ postgres_password }}
POSTGRES_DB={{ postgres_db | default('be2osm') }}

# =============================================================================
# DOMAIN CONFIGURATION
# =============================================================================
DOMAIN={{ domain }}

# =============================================================================
# APPLICATION SECRETS
# =============================================================================
JWT_SECRET={{ jwt_secret }}

# =============================================================================
# OSM OAUTH 2.0 CONFIGURATION
# =============================================================================
OSM_CLIENT_ID={{ osm_client_id }}
OSM_CLIENT_SECRET={{ osm_client_secret }}
OSM_REDIRECT_URI={{ osm_redirect_uri | default('https://' + domain + '/api/auth/osm-callback') }}

# =============================================================================
# GEOFABRIK OSM DATA
# =============================================================================
OSM_REGION={{ osm_region | default('europe/belgium') }}

# =============================================================================
# DIGITAL VLAANDEREN API
# =============================================================================
{% if digital_vlaanderen_api_key is defined and digital_vlaanderen_api_key %}
DIGITAL_VLAANDEREN_API_KEY={{ digital_vlaanderen_api_key }}
{% else %}
DIGITAL_VLAANDEREN_API_KEY=
{% endif %}
DIGITAL_VLAANDEREN_API_BASE_URL="https://download.api.vlaanderen.be/v2"

# =============================================================================
# DEPLOYMENT SETTINGS
# =============================================================================
TZ={{ timezone | default('Europe/Brussels') }}
NODE_ENV=production
{% if nuxt_image is defined and nuxt_image %}
NUXT_IMAGE={{ nuxt_image }}
{% endif %}
