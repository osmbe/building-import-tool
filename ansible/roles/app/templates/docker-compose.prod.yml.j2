# BE2OSM Production Docker Compose Override
# Generated by Ansible
# This file overrides settings in docker-compose.yml for production

services:
  caddy:
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./caddy/Caddyfile.prod:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config
    environment:
      - DOMAIN={{ domain }}

volumes:
  caddy_data:
  caddy_config:
