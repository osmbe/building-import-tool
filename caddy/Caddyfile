{
	admin off
}

{$DOMAIN} {
	encode zstd gzip

	# Logging
	log {
		output stdout
		format json
		level INFO
	}

	# Martin GRB Tiles
	handle /tiles/grb/* {
		uri strip_prefix /tiles/grb
		reverse_proxy grb-tiles:3000
	}

	# Martin OSM Tiles
	handle /tiles/osm/* {
		uri strip_prefix /tiles/osm
		reverse_proxy osm-tiles:3000
	}

	# All other routes (including /api/*) go to Nuxt
	# Nuxt will handle proxying to Rust API where needed
	handle {
		reverse_proxy nuxt-app:3000
	}
}
