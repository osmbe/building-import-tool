{
	# Global options
	admin off
	auto_https disable_redirects
}

{$DOMAIN:localhost} {
	# Enable compression
	encode gzip zstd

	# Logging
	log {
		output stdout
		format json
		level INFO
	}

	# GRB tile server
	handle /tiles/grb/* {
		uri strip_prefix /tiles/grb
		reverse_proxy grb-tiles:3001 {
			header_up X-Real-IP {remote_host}

			health_uri /health
			health_interval 30s
			health_timeout 10s
		}
	}

	# OSM tile server
	handle /tiles/osm/* {
		uri strip_prefix /tiles/osm
		reverse_proxy osm-tiles:3002 {
			header_up X-Real-IP {remote_host}

			health_uri /health
			health_interval 30s
			health_timeout 10s
		}
	}

	# Frontend - proxy to Nuxt
	handle /* {
		reverse_proxy nuxt-app:3000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Security headers
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Enable CORS for tile endpoints
	@tiles path /tiles/*
	header @tiles {
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Methods "GET, OPTIONS"
		Access-Control-Allow-Headers "Content-Type"
	}
}
