# OpenStreetMap OAuth 2.0 Configuration
# Register your application at: https://www.openstreetmap.org/oauth2/applications

# Your OSM OAuth 2.0 Client ID (public)
OSM_CLIENT_ID=your_client_id_here

# Your OSM OAuth 2.0 Client Secret (private, keep secure)
OSM_CLIENT_SECRET=your_client_secret_here

# OAuth Redirect URI (must match the one registered in OSM)
# For local development, use: http://localhost:3000/api/auth/osm-callback
# For production, use your domain: https://yourdomain.com/api/auth/osm-callback
OSM_REDIRECT_URI=http://localhost:3000/api/auth/osm-callback