# BE2OSM Data Update Cron Jobs
# Install with: crontab /path/to/crontab
# Or copy entries to existing crontab: crontab -e

# Environment
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
PROJECT_DIR=/opt/docker/buildings

# OSM: Daily update at 4:00 AM UTC (5:00 AM Brussels)
0 4 * * * cd $PROJECT_DIR && docker compose run --rm processing just osm-update >> /var/log/be2osm/osm-update.log 2>&1

# GRB: Weekly update on Sunday at 5:00 AM UTC (6:00 AM Brussels)
0 5 * * 0 cd $PROJECT_DIR && docker compose run --rm processing just grb-update >> /var/log/be2osm/grb-update.log 2>&1

# Database optimization: Daily at 6:00 AM UTC (after updates)
0 6 * * * cd $PROJECT_DIR && docker compose run --rm processing just db-optimize >> /var/log/be2osm/db-optimize.log 2>&1
