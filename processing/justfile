# Download Urbis GeoPackage (~350MB)
urbis-download:
    #!/usr/bin/env bash
    set -e
    mkdir -p {{urbis_data_dir}}

    echo "📥 Downloading Urbis GeoPackage..."
    echo "   URL: {{urbis_download_url}}"
    wget --tries=5 -O "{{urbis_data_dir}}/urbis.zip" "{{urbis_download_url}}"

    echo "   Extracting..."
    unzip -o "{{urbis_data_dir}}/urbis.zip" -d "{{urbis_data_dir}}"
    rm "{{urbis_data_dir}}/urbis.zip"

    echo ""
    echo "📋 Files extracted:"
    ls -la {{urbis_data_dir}}/ 2>/dev/null
    echo ""
    echo "✅ Urbis data downloaded to {{urbis_data_dir}}"

# Import downloaded Urbis data + create materialized view
urbis-import:
    @echo "🏙️  Urbis (Brussels) Data Import"
    @echo "=========================================="
    @echo "📅 Started at: $(date)"
    @echo ""
    @just _check-be2osm-database
    @just _check-urbis-schema
    @echo ""
    @just _urbis-import-buildings
    @just _urbis-import-addresses
    @just _urbis-import-lookups
    @just _urbis-create-matview
    @echo ""
    @just urbis-status
    @echo ""
    @echo "✅ Urbis import complete!"

# Complete Urbis workflow (download + import)
urbis-full: urbis-download urbis-import

# Update Urbis data (no differential API — full re-download)
urbis-update: clean-urbis urbis-full

# Show Urbis database statistics
urbis-status:
    @echo ""
    @echo "📊 Urbis (Brussels) Statistics:"
    @{{psql_be2osm}} -c "SELECT 'Buildings' as metric, COUNT(*)::text as value, pg_size_pretty(pg_total_relation_size('urbis.buildings')) as size FROM urbis.buildings UNION ALL SELECT 'Addresses', COUNT(*)::text, pg_size_pretty(pg_total_relation_size('urbis.addresses')) FROM urbis.addresses UNION ALL SELECT 'Buildings with addresses', COUNT(*)::text, pg_size_pretty(pg_total_relation_size('urbis.buildings_with_addresses')) FROM urbis.buildings_with_addresses;" 2>/dev/null || echo "   (Urbis tables not yet created - run just urbis-import first)"
    @echo ""

# Drop Urbis tables from database
clean-urbis:
    @echo "🧹 Dropping Urbis tables from database..."
    @{{psql_be2osm}} -c "DROP MATERIALIZED VIEW IF EXISTS urbis.buildings_with_addresses CASCADE; DROP TABLE IF EXISTS urbis.buildings CASCADE; DROP TABLE IF EXISTS urbis.addresses CASCADE; DROP TABLE IF EXISTS urbis.placenames CASCADE; DROP TABLE IF EXISTS urbis.municipalities CASCADE; DROP TABLE IF EXISTS urbis.postalzip CASCADE;" 2>/dev/null || echo "   Urbis tables not found"
    @echo "✅ Urbis tables dropped"

# Remove downloaded Urbis files
clean-urbis-downloads:
    @echo "🧹 Cleaning Urbis downloads..."
    rm -rf {{urbis_data_dir}}
    @echo "✅ Urbis downloads cleaned"

# Check Urbis schema exists
_check-urbis-schema:
    #!/usr/bin/env bash
    echo "Checking Urbis schema..."
    if ! {{psql_be2osm}} -tAc "SELECT 1 FROM information_schema.schemata WHERE schema_name = 'urbis'" | grep -q 1; then
        echo "❌ Urbis schema not found."
        echo ""
        echo "Run this to create the schema:"
        echo "  {{psql_be2osm}} -f ../postgres/06-setup-urbis.sql"
        exit 1
    fi
    echo "✓ Urbis schema exists"

# Import Urbis buildings from GeoPackage
_urbis-import-buildings:
    #!/usr/bin/env bash
    set -e
    echo "📥 Importing Urbis buildings from GeoPackage..."

    # Find .gpkg file
    GPKG_FILE=$(find {{urbis_data_dir}} -name "*.gpkg" -type f 2>/dev/null | head -1)

    if [ -z "$GPKG_FILE" ]; then
        echo "❌ GeoPackage (.gpkg) file not found in {{urbis_data_dir}}"
        echo ""
        echo "Run this first to download:"
        echo "  just urbis-download"
        exit 1
    fi

    echo "   Source: $GPKG_FILE"
    echo "   Layer:  {{urbis_buildings_layer}}"
    echo ""

    ogr2ogr -f PostgreSQL \
        "PG:host={{db_host}} port={{db_port}} dbname={{be2osm_db}} user={{db_user}} password={{db_password}}" \
        "$GPKG_FILE" "{{urbis_buildings_layer}}" \
        -nln urbis.buildings \
        -nlt PROMOTE_TO_MULTI \
        -overwrite \
        -lco GEOMETRY_NAME=geom \
        -lco SPATIAL_INDEX=NONE \
        -lco FID=inspire_id \
        -gt 100000 --config PG_USE_COPY YES

    echo "✅ Buildings imported"

# Import Urbis addresses from GeoPackage
