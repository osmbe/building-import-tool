# Import Urbis lookup tables (PlaceNames, Municipalities, PostalZip)
_urbis-import-lookups:
    #!/usr/bin/env bash
    set -e
    echo "📥 Importing Urbis lookup tables..."

    GPKG_FILE=$(find {{urbis_data_dir}} -name "*.gpkg" -type f 2>/dev/null | head -1)
    PG_CONN="PG:host={{db_host}} port={{db_port}} dbname={{be2osm_db}} user={{db_user}} password={{db_password}}"

    echo "   Importing PlaceNames (street names)..."
    ogr2ogr -f PostgreSQL "$PG_CONN" \
        "$GPKG_FILE" "{{urbis_placenames_layer}}" \
        -nln urbis.placenames \
        -overwrite \
        -lco SPATIAL_INDEX=NONE \
        -lco FID=inspire_id \
        -gt 100000 --config PG_USE_COPY YES

    echo "   Importing Municipalities..."
    ogr2ogr -f PostgreSQL "$PG_CONN" \
        "$GPKG_FILE" "{{urbis_municipalities_layer}}" \
        -nln urbis.municipalities \
        -overwrite \
        -lco GEOMETRY_NAME=geom \
        -lco SPATIAL_INDEX=NONE \
        -lco FID=inspire_id \
        -gt 100000 --config PG_USE_COPY YES

    echo "   Importing PostalZip..."
    ogr2ogr -f PostgreSQL "$PG_CONN" \
        "$GPKG_FILE" "{{urbis_postalzip_layer}}" \
        -nln urbis.postalzip \
        -overwrite \
        -lco SPATIAL_INDEX=NONE \
        -lco FID=inspire_id \
        -gt 100000 --config PG_USE_COPY YES

    echo "✅ Lookup tables imported"

# Create materialized view joining buildings with addresses (ID-based join via lookup tables)
_urbis-create-matview:
    #!/usr/bin/env bash
    set -e
    echo "🔄 Creating indexes on base tables..."

    {{psql_be2osm}} -c "
        CREATE INDEX IF NOT EXISTS idx_urbis_buildings_geom ON urbis.buildings USING GIST(geom);
        CREATE INDEX IF NOT EXISTS idx_urbis_addresses_bu_id ON urbis.addresses(bu_id);
        CREATE INDEX IF NOT EXISTS idx_urbis_addresses_street_id ON urbis.addresses(street_id);
        CREATE INDEX IF NOT EXISTS idx_urbis_addresses_municipality_id ON urbis.addresses(municipality_id);
        CREATE INDEX IF NOT EXISTS idx_urbis_addresses_zipcode_id ON urbis.addresses(zipcode_id);
    "

    echo "🔄 Analyzing base tables..."
    {{psql_be2osm}} -c "
        ANALYZE urbis.buildings;
        ANALYZE urbis.addresses;
        ANALYZE urbis.placenames;
        ANALYZE urbis.municipalities;
        ANALYZE urbis.postalzip;
    "

    echo "🔄 Creating materialized view (ID-based join via lookup tables)..."

    {{psql_be2osm}} -c "
        DROP MATERIALIZED VIEW IF EXISTS urbis.buildings_with_addresses CASCADE;

        CREATE MATERIALIZED VIEW urbis.buildings_with_addresses AS
        WITH addr_enriched AS (
            SELECT
                a.bu_id,
                a.policenum,
                a.boxnumber,
                COALESCE(pn.namefre, pn.namedut) AS street_name,
                m.namefre AS municipality_name,
                a.zipcode_id::text AS postcode
            FROM urbis.addresses a
            LEFT JOIN urbis.placenames pn ON a.street_id = pn.inspire_id
            LEFT JOIN urbis.municipalities m ON a.municipality_id = m.inspire_id
        ),
        addr_per_building AS (
            SELECT
                ae.bu_id,
                COUNT(*) AS address_count,
                array_to_string(ARRAY_AGG(DISTINCT (
                    ae.street_name || ' ' || ae.policenum ||
                    CASE WHEN ae.boxnumber IS NOT NULL AND ae.boxnumber != ''
                         THEN '/' || ae.boxnumber ELSE '' END
                ) ORDER BY (
                    ae.street_name || ' ' || ae.policenum ||
                    CASE WHEN ae.boxnumber IS NOT NULL AND ae.boxnumber != ''
                         THEN '/' || ae.boxnumber ELSE '' END
                )) FILTER (WHERE ae.street_name IS NOT NULL), '; ') AS addresses,
                array_to_string(ARRAY_AGG(DISTINCT ae.street_name ORDER BY ae.street_name)
                    FILTER (WHERE ae.street_name IS NOT NULL), ', ') AS street_names,
                array_to_string(ARRAY_AGG(DISTINCT ae.postcode ORDER BY ae.postcode)
                    FILTER (WHERE ae.postcode IS NOT NULL), ', ') AS postcodes,
                array_to_string(ARRAY_AGG(DISTINCT ae.municipality_name ORDER BY ae.municipality_name)
                    FILTER (WHERE ae.municipality_name IS NOT NULL), ', ') AS municipalities
            FROM addr_enriched ae
            GROUP BY ae.bu_id
        )
        SELECT
            b.inspire_id::BIGINT AS building_id,
            b.inspire_id,
            b.block_id,
            ST_Area(b.geom)::REAL AS area_m2,
            ST_Transform(b.geom, 3857)::geometry(Geometry, 3857) AS geom,
            COALESCE(apb.addresses, '') AS addresses,
            COALESCE(apb.street_names, '') AS street_names,
            COALESCE(apb.postcodes, '') AS postcodes,
            COALESCE(apb.municipalities, '') AS municipalities,
            COALESCE(apb.address_count, 0) AS address_count
        FROM urbis.buildings b
        LEFT JOIN addr_per_building apb ON b.inspire_id = apb.bu_id;
    "

    echo "🔄 Creating indexes on materialized view..."

    {{psql_be2osm}} -c "
        CREATE UNIQUE INDEX idx_urbis_matview_building_id ON urbis.buildings_with_addresses(building_id);
        CREATE INDEX idx_urbis_matview_geom ON urbis.buildings_with_addresses USING GIST(geom);
        CREATE INDEX idx_urbis_matview_postcodes ON urbis.buildings_with_addresses(postcodes);
    "

    echo "✅ Materialized view created"

