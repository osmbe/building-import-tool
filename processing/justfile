        echo ""
        echo "❌ Workflow failed with status: $STATUS"
        echo "   View logs: gh run view $RUN_ID -R {{gh_repo}} --log"
        exit 1
    fi

    # Download the artifact
    echo ""
    echo "📥 Downloading PICC dump artifact..."
    rm -rf /tmp/picc-restore
    mkdir -p /tmp/picc-restore
    gh run download "$RUN_ID" -R "{{gh_repo}}" -n picc-dump -D /tmp/picc-restore

    # Show artifact size
    ls -lh /tmp/picc-restore/picc.sql.gz

    # Drop existing tables before restore (full dump recreates them)
    echo ""
    echo "🧹 Dropping existing PICC tables..."
    {{psql_be2osm}} -c "DROP MATERIALIZED VIEW IF EXISTS picc.buildings_with_addresses CASCADE; DROP TABLE IF EXISTS picc.constr_batiemprise CASCADE; DROP TABLE IF EXISTS picc.icar_adr_pt CASCADE;" || true

    # Restore to local database
    echo ""
    echo "🔄 Restoring to local database..."
    gunzip -c /tmp/picc-restore/picc.sql.gz | {{psql_be2osm}}

    # Post-restore: update statistics
    echo ""
    echo "📊 Updating database statistics..."
    {{psql_be2osm}} -c "ANALYZE picc.constr_batiemprise; ANALYZE picc.icar_adr_pt;"

    # Cleanup
    rm -rf /tmp/picc-restore

    echo ""
    echo "✅ Remote PICC Import Complete!"
    echo ""
    just picc-status

