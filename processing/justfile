# Download Belgium OSM data from Geofabrik
osm-download:
    @echo "📥 Downloading OSM data for {{osm_region}}..."
    @mkdir -p data/osm
    curl -L -o "{{osm_file}}" "https://download.geofabrik.de/{{osm_region}}-latest.osm.pbf"
    @echo "✅ Downloaded to {{osm_file}}"

# Import OSM buildings using imposm3 and transform to schema
osm-import:
    @echo "🚀 OSM Buildings Import with imposm3"
    @echo "========================================"
    @echo "📅 Started at: $(date)"
    @echo ""
    @just _check-server
    @just _check-osm-database
    @just _check-osm-schema
    @just _check-osm-file
    @just _check-imposm
    @echo ""
    @echo "📊 Configuration:"
    @echo "   Database: {{osmbe_db}} @ {{db_host}}:{{db_port}}"
    @echo "   OSM File: {{osm_file}}"
    @echo "   Mapping:  {{mapping_file}}"
    @echo "   Cache:    {{cache_dir}}"
    @echo ""
    @just _osm-imposm-read
    @just _osm-imposm-write
    @just _osm-transform-schema
    @just _osm-cleanup-import
    @just osm-status
    @echo ""
    @echo "💡 Next steps:"
    @echo "   - Import GRB: just grb-full"
    @echo "   - Check status: just osm-status"

# Clean cache and reimport OSM data
osm-rebuild:
    @just clean-osm-cache
    @just osm-import

# Apply daily diff updates from Geofabrik (incremental update)
osm-update:
    @echo "🔄 OSM Incremental Update (Geofabrik Daily Diffs)"
    @echo "========================================"
    @echo "📅 Started at: $(date)"
    @echo ""
    @just _check-server
    @just _check-osm-database
    @just _check-imposm
    @just _osm-setup-replication
    @just _osm-run-update
    @just _osm-transform-schema
    @just osm-status
    @echo ""
    @echo "✅ OSM update complete!"

# Show OSM database statistics
osm-status:
    @echo ""
    @echo "🎉 OSM Import Complete!"
    @echo "========================================"
    @echo "📅 Finished at: $(date)"
    @echo ""
    @echo "📈 Statistics:"
    @{{psql_osmbe}} -c "SELECT 'Total buildings' as metric, COUNT(*)::text as value FROM osm.osm_buildings UNION ALL SELECT 'With GRB reference', COUNT(*)::text FROM osm.osm_buildings WHERE tags ? 'source:geometry:ref' OR oidn IS NOT NULL UNION ALL SELECT 'With addresses', COUNT(*)::text FROM osm.osm_buildings WHERE tags ? 'addr:street' UNION ALL SELECT 'Building types', COUNT(DISTINCT building_type)::text FROM osm.osm_buildings;"
    @echo ""

