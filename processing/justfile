# ============================================================================
# PICC TASKS - Wallonia PICC Data Import (native shapefiles/FileGDB)
# ============================================================================

# Download PICC buildings (FileGDB ~3.6GB) and ICAR addresses (shapefile ~98MB)
# URLs are resolved dynamically from MetaWal GeoNetwork metadata API
picc-download:
    #!/usr/bin/env bash
    set -e
    mkdir -p {{picc_data_dir}}

    echo "🔍 Resolving PICC buildings download URL from MetaWal..."
    BUILDINGS_URL=$(curl -sf -H "Accept: application/json" \
        "{{metawal_api}}/{{picc_buildings_uuid}}" \
        | grep -oP 'https://geoservices\.wallonie\.be/geotraitement/spwdatadownload/results/[^"]*FILEGDB[^"]*\.zip' \
        | head -1)
    if [ -z "$BUILDINGS_URL" ]; then
        echo "❌ Could not resolve PICC buildings download URL from MetaWal API"
        exit 1
    fi
    echo "   → $BUILDINGS_URL"

    echo "🔍 Resolving ICAR addresses download URL from MetaWal..."
    ADDRESSES_URL=$(curl -sf -H "Accept: application/json" \
        "{{metawal_api}}/{{picc_addresses_uuid}}" \
        | grep -oP 'https://geoservices\.wallonie\.be/geotraitement/spwdatadownload/results/[^"]*shp[^"]*\.zip' \
        | head -1)
    if [ -z "$ADDRESSES_URL" ]; then
        echo "❌ Could not resolve ICAR addresses download URL from MetaWal API"
        exit 1
    fi
    echo "   → $ADDRESSES_URL"

    echo ""
    echo "📥 Downloading PICC buildings (FileGDB ~3.6GB)..."
    wget --tries=5 -O "{{picc_data_dir}}/picc_buildings.zip" "$BUILDINGS_URL"
    echo "   Extracting..."
    unzip -o "{{picc_data_dir}}/picc_buildings.zip" -d "{{picc_data_dir}}"
    rm "{{picc_data_dir}}/picc_buildings.zip"

    echo ""
    echo "📥 Downloading ICAR addresses (shapefile ~98MB)..."
    wget --tries=5 -O "{{picc_data_dir}}/icar_addresses.zip" "$ADDRESSES_URL"
    echo "   Extracting..."
    unzip -o "{{picc_data_dir}}/icar_addresses.zip" -d "{{picc_data_dir}}"
    rm "{{picc_data_dir}}/icar_addresses.zip"

    echo ""
    echo "📋 Files extracted:"
    ls -la {{picc_data_dir}}/ 2>/dev/null
    echo ""
    echo "✅ PICC data downloaded to {{picc_data_dir}}"

# Import downloaded PICC data. The tables and the view are owned by migrations (sql/migrations/picc): the files
# are loaded into picc._raw_* tables, then mapped into picc.buildings / picc.addresses by picc.load_raw() in one
# transaction, and the view is refreshed concurrently, so tiles keep the previous data until the end.
picc-import:
    @echo "🏛️  PICC (Wallonia) Data Import"
    @echo "=========================================="
    @echo "📅 Started at: $(date)"
    @echo ""
    @just _check-be2osm-database
    @just db-migrate
    @echo ""
    @just _picc-load-raw-download
    @just _picc-load
    @just _picc-refresh-matview
    @just _picc-save-last-update
    @echo ""
    @just picc-status
    @echo ""
    @echo "✅ PICC import complete!"

# Complete PICC workflow (download + import)
picc-full: picc-download picc-import

