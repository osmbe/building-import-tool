# Show PICC database statistics
picc-status:
    @echo ""
    @echo "📊 PICC (Wallonia) Statistics:"
    @{{psql_be2osm}} -c "SELECT 'Buildings' as metric, COUNT(*)::text as value, pg_size_pretty(pg_total_relation_size('picc.constr_batiemprise')) as size FROM picc.constr_batiemprise UNION ALL SELECT 'Addresses', COUNT(*)::text, pg_size_pretty(pg_total_relation_size('picc.icar_adr_pt')) FROM picc.icar_adr_pt UNION ALL SELECT 'Buildings with addresses', COUNT(*)::text, pg_size_pretty(pg_total_relation_size('picc.buildings_with_addresses')) FROM picc.buildings_with_addresses;" 2>/dev/null || echo "   (PICC tables not yet created - run just picc-import first)"
    @echo ""

# Drop PICC tables from database
clean-picc:
    @echo "🧹 Dropping PICC tables from database..."
    @{{psql_be2osm}} -c "DROP MATERIALIZED VIEW IF EXISTS picc.buildings_with_addresses CASCADE; DROP TABLE IF EXISTS picc.constr_batiemprise CASCADE; DROP TABLE IF EXISTS picc.icar_adr_pt CASCADE;" 2>/dev/null || echo "   PICC tables not found"
    @echo "✅ PICC tables dropped"

# Remove downloaded PICC files
clean-picc-downloads:
    @echo "🧹 Cleaning PICC downloads..."
    rm -rf {{picc_data_dir}}
    @echo "✅ PICC downloads cleaned"

# Check PICC schema exists
_check-picc-schema:
    #!/usr/bin/env bash
    echo "Checking PICC schema..."
    if ! {{psql_be2osm}} -tAc "SELECT 1 FROM information_schema.schemata WHERE schema_name = 'picc'" | grep -q 1; then
        echo "❌ PICC schema not found."
        echo ""
        echo "Run this to create the schema:"
        echo "  {{psql_be2osm}} -f ../postgres/05-setup-picc.sql"
        exit 1
    fi
    echo "✓ PICC schema exists"

# Import PICC buildings from FileGDB
_picc-import-buildings:
    #!/usr/bin/env bash
    set -e
    echo "📥 Importing PICC buildings from FileGDB..."

    # Find .gdb directory
    GDB_DIR=$(find {{picc_data_dir}} -name "*.gdb" -type d 2>/dev/null | head -1)

    if [ -z "$GDB_DIR" ]; then
        echo "❌ FileGDB (.gdb) directory not found in {{picc_data_dir}}"
        echo ""
        echo "Run this first to download:"
        echo "  just picc-download"
        exit 1
    fi

    echo "   Source: $GDB_DIR"
    echo "   Layer:  {{picc_buildings_layer}}"
    echo ""

    ogr2ogr -f PostgreSQL \
        "PG:host={{db_host}} port={{db_port}} dbname={{be2osm_db}} user={{db_user}} password={{db_password}}" \
        "$GDB_DIR" "{{picc_buildings_layer}}" \
        -nln picc.constr_batiemprise \
        -nlt PROMOTE_TO_MULTI \
        -overwrite \
        -lco GEOMETRY_NAME=geom \
        -lco SPATIAL_INDEX=NONE \
        -gt 100000 --config PG_USE_COPY YES

    echo "✅ Buildings imported"

# Import ICAR addresses from shapefile
_picc-import-addresses:
    #!/usr/bin/env bash
    set -e
    echo "📥 Importing ICAR addresses from shapefile..."

    # Find shapefile
    ICAR_FILE=$(find {{picc_data_dir}} -name "*.shp" -type f 2>/dev/null | head -1)

    if [ -z "$ICAR_FILE" ]; then
        echo "❌ ICAR shapefile not found in {{picc_data_dir}}"
        echo ""
        echo "Run this first to download:"
        echo "  just picc-download"
        exit 1
    fi

    echo "   Source: $ICAR_FILE"
    echo ""

    ogr2ogr -f PostgreSQL \
        "PG:host={{db_host}} port={{db_port}} dbname={{be2osm_db}} user={{db_user}} password={{db_password}}" \
        "$ICAR_FILE" \
        -nln picc.icar_adr_pt \
        -overwrite \
        -lco GEOMETRY_NAME=geom \
        -lco SPATIAL_INDEX=NONE \
        -lco PRECISION=NO \
        -gt 100000 --config PG_USE_COPY YES

    echo "✅ Addresses imported"

# Create materialized view joining buildings with addresses
_picc-create-matview:
    #!/usr/bin/env bash
    set -e
    echo "🔄 Creating indexes on base tables..."

    {{psql_be2osm}} -c "
        CREATE INDEX IF NOT EXISTS idx_picc_buildings_geom ON picc.constr_batiemprise USING GIST(geom);
        CREATE INDEX IF NOT EXISTS idx_picc_addresses_geom ON picc.icar_adr_pt USING GIST(geom);
    "

    echo "🔄 Analyzing base tables..."
    {{psql_be2osm}} -c "ANALYZE picc.constr_batiemprise; ANALYZE picc.icar_adr_pt;"

    echo "🔄 Creating materialized view (spatial join — may take a while)..."

    {{psql_be2osm}} -c "
        DROP MATERIALIZED VIEW IF EXISTS picc.buildings_with_addresses CASCADE;

        CREATE MATERIALIZED VIEW picc.buildings_with_addresses AS
        WITH addr_per_building AS (
            SELECT
                b.objectid,
                COUNT(*) AS address_count,
                array_to_string(ARRAY_AGG(DISTINCT (a.rue_nm || ' ' || a.adr_numero)
                    ORDER BY (a.rue_nm || ' ' || a.adr_numero))
                    FILTER (WHERE a.rue_nm IS NOT NULL), '; ') AS addresses,
                array_to_string(ARRAY_AGG(DISTINCT a.rue_nm ORDER BY a.rue_nm)
                    FILTER (WHERE a.rue_nm IS NOT NULL), ', ') AS street_names,
                array_to_string(ARRAY_AGG(DISTINCT a.code_posta ORDER BY a.code_posta)
                    FILTER (WHERE a.code_posta IS NOT NULL), ', ') AS postcodes,
                array_to_string(ARRAY_AGG(DISTINCT a.com_nm ORDER BY a.com_nm)
                    FILTER (WHERE a.com_nm IS NOT NULL), ', ') AS municipalities
            FROM picc.constr_batiemprise b
            JOIN picc.icar_adr_pt a ON ST_Contains(ST_Force2D(ST_SetSRID(b.geom, 31370)), a.geom)
            GROUP BY b.objectid
        )
        SELECT
            b.objectid::BIGINT AS objectid,
            b.georef_id,
            b.natur_code,
            b.natur_desc,
            b.date_leve,
            b.date_modif,
            ST_Area(ST_Force2D(ST_SetSRID(b.geom, 31370)))::REAL AS area_m2,
            ST_Transform(ST_Force2D(ST_SetSRID(b.geom, 31370)), 3857)::geometry(Geometry, 3857) AS geom,
            COALESCE(apb.addresses, '') AS addresses,
            COALESCE(apb.street_names, '') AS street_names,
            COALESCE(apb.postcodes, '') AS postcodes,
            COALESCE(apb.municipalities, '') AS municipalities,
            COALESCE(apb.address_count, 0) AS address_count
        FROM picc.constr_batiemprise b
        LEFT JOIN addr_per_building apb ON b.objectid = apb.objectid;
    "

    echo "🔄 Creating indexes on materialized view..."

    {{psql_be2osm}} -c "
        CREATE UNIQUE INDEX idx_picc_matview_objectid ON picc.buildings_with_addresses(objectid);
        CREATE INDEX idx_picc_matview_geom ON picc.buildings_with_addresses USING GIST(geom);
        CREATE INDEX idx_picc_matview_natur_code ON picc.buildings_with_addresses(natur_code);
        CREATE INDEX idx_picc_matview_postcodes ON picc.buildings_with_addresses(postcodes);
    "

    echo "✅ Materialized view created"

# ============================================================================
# PICC PER-PROVINCE TASKS - Used by GitHub Actions parallel pipeline
# ============================================================================

# Download and import a single province shapefile (used by CI matrix jobs)
# Produces a custom-format pg_dump for use by picc-finalize-provinces
# Usage: just picc-province-import PROVINCE_NAME
#   PROVINCE_NAME: BRABANT_WALLON, HAINAUT, LIEGE, LUXEMBOURG, NAMUR
picc-province-import province:
    #!/usr/bin/env bash
    set -e
    PROVINCE="{{province}}"
    DATA_DIR="{{picc_data_dir}}/${PROVINCE}"
    mkdir -p "${DATA_DIR}"

    echo "🔍 Resolving download URL for province ${PROVINCE}..."
    PROVINCE_URL=$(curl -sf -H "Accept: application/json" \
        "{{metawal_api}}/{{picc_buildings_uuid}}" \
        | grep -oP "https://geoservices\.wallonie\.be/geotraitement/spwdatadownload/results/[^\"]*SHAPE_31370_PROV_${PROVINCE}[^\"]*\.zip" \
        | head -1)
    if [ -z "$PROVINCE_URL" ]; then
        echo "❌ Could not resolve download URL for province ${PROVINCE}"
        exit 1
    fi
    echo "   → $PROVINCE_URL"

    echo ""
    echo "📥 Downloading ${PROVINCE}..."
    wget --tries=5 -O "${DATA_DIR}/province.zip" "$PROVINCE_URL"
    echo "   Extracting..."
    unzip -o "${DATA_DIR}/province.zip" -d "${DATA_DIR}"
    rm "${DATA_DIR}/province.zip"

    echo ""
    echo "📥 Importing buildings ({{picc_buildings_layer}})..."
    ogr2ogr -f PostgreSQL \
        "PG:host={{db_host}} port={{db_port}} dbname={{be2osm_db}} user={{db_user}} password={{db_password}}" \
        "${DATA_DIR}/{{picc_buildings_layer}}.shp" \
        -nln picc.constr_batiemprise \
        -nlt PROMOTE_TO_MULTI \
        -overwrite \
        -lco GEOMETRY_NAME=geom \
        -lco SPATIAL_INDEX=NONE \
        -gt 100000 --config PG_USE_COPY YES

    if [ -f "${DATA_DIR}/{{picc_addresses_layer}}.shp" ]; then
        echo "📥 Importing addresses ({{picc_addresses_layer}})..."
        ogr2ogr -f PostgreSQL \
            "PG:host={{db_host}} port={{db_port}} dbname={{be2osm_db}} user={{db_user}} password={{db_password}}" \
            "${DATA_DIR}/{{picc_addresses_layer}}.shp" \
            -nln picc.icar_adr_pt \
            -overwrite \
            -lco GEOMETRY_NAME=geom \
            -lco SPATIAL_INDEX=NONE \
            -lco PRECISION=NO \
            -gt 100000 --config PG_USE_COPY YES
    else
        echo "⚠️  ADRESS_POINT.shp not found in province archive, skipping address import"
    fi

    echo ""
    echo "📊 Province ${PROVINCE} counts:"
    {{psql_be2osm}} -c "SELECT 'buildings' as t, COUNT(*) FROM picc.constr_batiemprise;"
    {{psql_be2osm}} -c "SELECT 'addresses' as t, COUNT(*) FROM picc.icar_adr_pt;" 2>/dev/null || echo "   (no addresses table)"

    echo ""
    echo "📦 Creating dump for province ${PROVINCE}..."
    pg_dump -h {{db_host}} -p {{db_port}} -U {{db_user}} \
        -Fc --no-owner --no-acl -n picc {{be2osm_db}} \
        > "{{picc_data_dir}}/picc-${PROVINCE}.dump"
    ls -lh "{{picc_data_dir}}/picc-${PROVINCE}.dump"

    echo ""
    echo "✅ Province ${PROVINCE} done"

# Restore province dumps and create materialized view (used by CI finalize job)
# Uses pg_restore custom format: schema from first dump, data from all dumps
# Usage: just picc-finalize-provinces /path/to/dumps/dir
picc-finalize-provinces dumps_dir:
    #!/usr/bin/env bash
    set -e
    DUMPS_DIR="{{dumps_dir}}"

    echo "🏛️  PICC Finalize: Restoring province dumps + creating matview"
    echo "=========================================="

    # Collect all province dumps
    DUMPS=("${DUMPS_DIR}"/picc-*.dump)
    if [ ${#DUMPS[@]} -eq 0 ]; then
        echo "❌ No province dumps found in ${DUMPS_DIR}"
        exit 1
    fi
    echo "📋 Found ${#DUMPS[@]} province dumps"

    # Restore table schema from first dump (pre-data section only)
    echo ""
    echo "🔄 Creating tables from ${DUMPS[0]}..."
    pg_restore --section=pre-data -d "{{be2osm_db}}" \
        -h {{db_host}} -p {{db_port}} -U {{db_user}} \
        --no-owner --no-acl \
        "${DUMPS[0]}" || true

    # Restore data from ALL province dumps
    # (ogc_fid values overlap between provinces, but PK constraint is in post-data
    #  section which we skip, so no conflict)
    for DUMP in "${DUMPS[@]}"; do
        PROV_NAME=$(basename "$DUMP" .dump | sed 's/picc-//')
        echo "🔄 Restoring data: ${PROV_NAME}..."
        pg_restore --section=data -d "{{be2osm_db}}" \
            -h {{db_host}} -p {{db_port}} -U {{db_user}} \
            --no-owner --no-acl \
            "$DUMP"
    done

    echo ""
    echo "📊 Row counts after restore:"
    {{psql_be2osm}} -c "SELECT 'buildings' as table_name, COUNT(*) FROM picc.constr_batiemprise UNION ALL SELECT 'addresses', COUNT(*) FROM picc.icar_adr_pt;"

    # Skip post-data (ogc_fid PK would conflict). Create our own indexes.
    echo ""
    echo "🔄 Creating indexes and materialized view..."
    just _picc-create-matview-provinces

    just _picc-save-last-update

    echo ""
    echo "✅ PICC finalize complete!"

# Create materialized view for per-province imports (ADRESS_POINT column names)
_picc-create-matview-provinces:
    #!/usr/bin/env bash
    set -e
    echo "🔄 Creating indexes on base tables..."

    {{psql_be2osm}} -c "
        CREATE INDEX IF NOT EXISTS idx_picc_buildings_geom ON picc.constr_batiemprise USING GIST(geom);
        CREATE INDEX IF NOT EXISTS idx_picc_addresses_geom ON picc.icar_adr_pt USING GIST(geom);
    "

    echo "🔄 Analyzing base tables..."
    {{psql_be2osm}} -c "ANALYZE picc.constr_batiemprise; ANALYZE picc.icar_adr_pt;"

    echo "🔄 Creating materialized view (spatial join — may take a while)..."

    {{psql_be2osm}} -c "
        DROP MATERIALIZED VIEW IF EXISTS picc.buildings_with_addresses CASCADE;

        CREATE MATERIALIZED VIEW picc.buildings_with_addresses AS
        WITH addr_per_building AS (
            SELECT
                b.objectid,
                COUNT(*) AS address_count,
                array_to_string(ARRAY_AGG(DISTINCT (a.rue_nom || ' ' || a.numero)
                    ORDER BY (a.rue_nom || ' ' || a.numero))
                    FILTER (WHERE a.rue_nom IS NOT NULL), '; ') AS addresses,
                array_to_string(ARRAY_AGG(DISTINCT a.rue_nom ORDER BY a.rue_nom)
                    FILTER (WHERE a.rue_nom IS NOT NULL), ', ') AS street_names,
                array_to_string(ARRAY_AGG(DISTINCT a.codepostal::int::text ORDER BY a.codepostal::int::text)
                    FILTER (WHERE a.codepostal IS NOT NULL AND a.codepostal = a.codepostal), ', ') AS postcodes,
                array_to_string(ARRAY_AGG(DISTINCT a.commu_nom ORDER BY a.commu_nom)
                    FILTER (WHERE a.commu_nom IS NOT NULL), ', ') AS municipalities
            FROM picc.constr_batiemprise b
            JOIN picc.icar_adr_pt a ON ST_Contains(ST_Force2D(ST_SetSRID(b.geom, 31370)), a.geom)
            GROUP BY b.objectid
        )
        SELECT
            b.objectid::BIGINT AS objectid,
            b.georef_id,
            b.natur_code,
            b.natur_desc,
            b.date_leve,
            b.date_modif,
            ST_Area(ST_Force2D(ST_SetSRID(b.geom, 31370)))::REAL AS area_m2,
            ST_Transform(ST_Force2D(ST_SetSRID(b.geom, 31370)), 3857)::geometry(Geometry, 3857) AS geom,
            COALESCE(apb.addresses, '') AS addresses,
            COALESCE(apb.street_names, '') AS street_names,
            COALESCE(apb.postcodes, '') AS postcodes,
            COALESCE(apb.municipalities, '') AS municipalities,
            COALESCE(apb.address_count, 0) AS address_count
        FROM picc.constr_batiemprise b
        LEFT JOIN addr_per_building apb ON b.objectid = apb.objectid;
    "

    echo "🔄 Checking objectid uniqueness..."
    DUPES=$({{psql_be2osm}} -tAc "SELECT COUNT(*) FROM (SELECT objectid FROM picc.buildings_with_addresses GROUP BY objectid HAVING COUNT(*) > 1) d;")
    if [ "$DUPES" -gt 0 ]; then
        echo "⚠️  Found $DUPES duplicate objectids across provinces — using non-unique index"
        {{psql_be2osm}} -c "
            CREATE INDEX idx_picc_matview_objectid ON picc.buildings_with_addresses(objectid);
        "
    else
        echo "   ✓ All objectids are unique"
        {{psql_be2osm}} -c "
            CREATE UNIQUE INDEX idx_picc_matview_objectid ON picc.buildings_with_addresses(objectid);
        "
    fi

    echo "🔄 Creating remaining indexes on materialized view..."
    {{psql_be2osm}} -c "
        CREATE INDEX idx_picc_matview_geom ON picc.buildings_with_addresses USING GIST(geom);
        CREATE INDEX idx_picc_matview_natur_code ON picc.buildings_with_addresses(natur_code);
        CREATE INDEX idx_picc_matview_postcodes ON picc.buildings_with_addresses(postcodes);
    "

    echo "✅ Materialized view created"

# ============================================================================
# URBIS TASKS - Brussels-Capital Region Data Import (GeoPackage)
