    @echo ""
    @echo "📊 PICC (Wallonia) Statistics:"
    @{{psql_be2osm}} -c "SELECT 'Buildings' as metric, COUNT(*)::text as value, pg_size_pretty(pg_total_relation_size('picc.buildings')) as size FROM picc.buildings UNION ALL SELECT 'Addresses', COUNT(*)::text, pg_size_pretty(pg_total_relation_size('picc.addresses')) FROM picc.addresses UNION ALL SELECT 'Buildings with addresses', COUNT(*)::text, pg_size_pretty(pg_total_relation_size('picc.buildings_with_addresses')) FROM picc.buildings_with_addresses;" 2>/dev/null || echo "   (PICC tables not yet created - run just db-migrate first)"
    @echo ""

# Empty the PICC tables (the schema stays: it belongs to the migrations)
clean-picc:
    @echo "🧹 Emptying the PICC tables..."
    @{{psql_be2osm}} -v ON_ERROR_STOP=1 -c "TRUNCATE picc.buildings, picc.addresses; REFRESH MATERIALIZED VIEW picc.buildings_with_addresses;"
    @echo "✅ PICC tables emptied"

# Remove downloaded PICC files
clean-picc-downloads:
    @echo "🧹 Cleaning PICC downloads..."
    rm -rf {{picc_data_dir}}
    @echo "✅ PICC downloads cleaned"

# Load the full download into picc._raw_buildings (CONSTR_BATIEMPRISE of the FileGDB) and picc._raw_addresses
# (the ICAR shapefile)
_picc-load-raw-download:
    #!/usr/bin/env bash
    set -euo pipefail
    GDB_DIR=$(find {{picc_data_dir}} -name "*.gdb" -type d 2>/dev/null | head -1)
    ICAR_FILE=$(find {{picc_data_dir}} -maxdepth 2 -name "*.shp" -type f 2>/dev/null | head -1)
    if [ -z "$GDB_DIR" ] || [ -z "$ICAR_FILE" ]; then
        echo "❌ FileGDB (.gdb) or ICAR shapefile not found in {{picc_data_dir}}: run just picc-download first"
        exit 1
    fi
    echo "📥 Loading $GDB_DIR ({{picc_buildings_layer}}) and $ICAR_FILE..."
    just _picc-ogr "$GDB_DIR" picc._raw_buildings "{{picc_buildings_layer}}"
    just _picc-ogr "$ICAR_FILE" picc._raw_addresses
    echo "✅ Raw PICC tables loaded"

# ogr2ogr one PICC source layer into a raw table. Usage: just _picc-ogr <source> <table> [layer]
_picc-ogr source table layer="":
    ogr2ogr -f PostgreSQL \
        "PG:host={{db_host}} port={{db_port}} dbname={{be2osm_db}} user={{db_user}} password={{db_password}}" \
        "{{source}}" {{layer}} -nln {{table}} -overwrite -nlt PROMOTE_TO_MULTI \
        -lco GEOMETRY_NAME=geom -lco SPATIAL_INDEX=NONE -lco PRECISION=NO \
        -gt 100000 --config PG_USE_COPY YES

# Replace picc.buildings / picc.addresses by the raw tables, in one transaction
_picc-load:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "🔄 Loading the raw tables into picc.buildings / picc.addresses..."
    {{psql_be2osm}} -X -q -v ON_ERROR_STOP=1 <<'SQL'
    SET client_min_messages = warning;
    BEGIN;
    TRUNCATE picc.buildings, picc.addresses;
    SELECT format('   %s buildings, %s addresses', buildings, addresses) AS loaded
    FROM picc.load_raw('picc._raw_buildings', to_regclass('picc._raw_addresses')) \gset
    \echo :loaded
    DROP TABLE IF EXISTS picc._raw_buildings, picc._raw_addresses;
    COMMIT;
    ANALYZE picc.buildings;
    ANALYZE picc.addresses;
    SQL
    echo "✅ PICC data loaded"

# Refresh the view; CONCURRENTLY (readers keep the previous contents) once it has been populated
_picc-refresh-matview:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "🔄 Refreshing picc.buildings_with_addresses (spatial join, may take a while)..."
    POPULATED=$({{psql_be2osm}} -tAc "SELECT ispopulated FROM pg_matviews WHERE schemaname = 'picc' AND matviewname = 'buildings_with_addresses'")
    CONCURRENTLY=""
    [ "$POPULATED" = "t" ] && CONCURRENTLY="CONCURRENTLY"
    {{psql_be2osm}} -v ON_ERROR_STOP=1 -c "REFRESH MATERIALIZED VIEW $CONCURRENTLY picc.buildings_with_addresses;"
    echo "✅ Materialized view refreshed"

# ============================================================================
# PICC PER-PROVINCE TASKS - Used by GitHub Actions parallel pipeline
# ============================================================================

# Download and load a single province (used by CI matrix jobs) into raw tables, and dump them for
# picc-finalize-provinces. Usage: just picc-province-import PROVINCE_NAME
#   PROVINCE_NAME: BRABANT_WALLON, HAINAUT, LIEGE, LUXEMBOURG, NAMUR
picc-province-import province:
    #!/usr/bin/env bash
    set -euo pipefail
    PROVINCE="{{province}}"
    DATA_DIR="{{picc_data_dir}}/${PROVINCE}"
    mkdir -p "${DATA_DIR}"

    echo "🔍 Resolving download URL for province ${PROVINCE}..."
    PROVINCE_URL=$(curl -sf -H "Accept: application/json" \
        "{{metawal_api}}/{{picc_buildings_uuid}}" \
        | grep -oP "https://geoservices\.wallonie\.be/geotraitement/spwdatadownload/results/[^\"]*SHAPE_31370_PROV_${PROVINCE}[^\"]*\.zip" \
        | head -1)
    if [ -z "$PROVINCE_URL" ]; then
        echo "❌ Could not resolve download URL for province ${PROVINCE}"
        exit 1
    fi
    echo "   → $PROVINCE_URL"

    echo ""
    echo "📥 Downloading ${PROVINCE}..."
    wget --tries=5 -O "${DATA_DIR}/province.zip" "$PROVINCE_URL"
    echo "   Extracting..."
    unzip -o "${DATA_DIR}/province.zip" -d "${DATA_DIR}"
    rm "${DATA_DIR}/province.zip"

    just picc-province-load "${PROVINCE}"

# Load an extracted province (data/picc/<PROVINCE>/{CONSTR_BATIEMPRISE,ADRESS_POINT}.shp) into raw tables and
# dump them to data/picc/picc-<PROVINCE>.dump (custom format, raw tables only)
picc-province-load province:
    #!/usr/bin/env bash
    set -euo pipefail
    PROVINCE="{{province}}"
    DATA_DIR="{{picc_data_dir}}/${PROVINCE}"
    {{psql_be2osm}} -q -c "CREATE SCHEMA IF NOT EXISTS picc"
    echo "📥 Loading ${PROVINCE} buildings ({{picc_buildings_layer}})..."
    just _picc-ogr "${DATA_DIR}/{{picc_buildings_layer}}.shp" picc._raw_buildings
    TABLES=(-t picc._raw_buildings)
    if [ -f "${DATA_DIR}/{{picc_addresses_layer}}.shp" ]; then
        echo "📥 Loading ${PROVINCE} addresses ({{picc_addresses_layer}})..."
        just _picc-ogr "${DATA_DIR}/{{picc_addresses_layer}}.shp" picc._raw_addresses
        TABLES+=(-t picc._raw_addresses)
    else
        echo "⚠️  {{picc_addresses_layer}}.shp not found in the province archive, no addresses"
    fi
    {{psql_be2osm}} -c "SELECT 'buildings' AS t, COUNT(*) FROM picc._raw_buildings;"
    echo "📦 Dumping ${PROVINCE}..."
    pg_dump -h {{db_host}} -p {{db_port}} -U {{db_user}} -Fc --no-owner --no-acl "${TABLES[@]}" {{be2osm_db}} \
        > "{{picc_data_dir}}/picc-${PROVINCE}.dump"
    ls -lh "{{picc_data_dir}}/picc-${PROVINCE}.dump"
    echo "✅ Province ${PROVINCE} done"

# Merge the province dumps into picc.buildings / picc.addresses and refresh the view (used by the CI finalize
# job). Usage: just picc-finalize-provinces /path/to/dumps/dir
picc-finalize-provinces dumps_dir:
    #!/usr/bin/env bash
    set -euo pipefail
    DUMPS=("{{dumps_dir}}"/picc-*.dump)
    [ -e "${DUMPS[0]}" ] || { echo "❌ No province dumps found in {{dumps_dir}}"; exit 1; }
    echo "🏛️  PICC Finalize: ${#DUMPS[@]} province dumps"
    just db-migrate
    {{psql_be2osm}} -q -c "SET client_min_messages = warning; DROP TABLE IF EXISTS picc._raw_buildings, picc._raw_addresses;"
    # The raw tables come from the dumps' pre-data (every dump: a province may lack addresses). Each table is
    # created by the first dump that has it; the "already exists" errors of the next ones are expected.
    for DUMP in "${DUMPS[@]}"; do
        pg_restore --section=pre-data -d "{{be2osm_db}}" -h {{db_host}} -p {{db_port}} -U {{db_user}} \
            --no-owner --no-acl "$DUMP" 2>/dev/null || true
    done
    # The raw ogc_fid values overlap between provinces; their primary key is in post-data, which is skipped
    for DUMP in "${DUMPS[@]}"; do
        echo "🔄 Restoring $(basename "$DUMP" .dump)..."
        pg_restore --section=data -d "{{be2osm_db}}" -h {{db_host}} -p {{db_port}} -U {{db_user}} \
            --no-owner --no-acl --exit-on-error "$DUMP"
    done
    just _picc-load
    just _picc-refresh-matview
    just _picc-save-last-update
    just picc-status
    echo "✅ PICC finalize complete!"

# ============================================================================
# URBIS TASKS - Brussels-Capital Region Data Import (GeoPackage)
# ============================================================================

# Download Urbis GeoPackage (~350MB)
urbis-download:
    #!/usr/bin/env bash
    set -e
    mkdir -p {{urbis_data_dir}}

    echo "📥 Downloading Urbis GeoPackage..."
    echo "   URL: {{urbis_download_url}}"
    wget --tries=5 -O "{{urbis_data_dir}}/urbis.zip" "{{urbis_download_url}}"

    echo "   Extracting..."
    unzip -o "{{urbis_data_dir}}/urbis.zip" -d "{{urbis_data_dir}}"
    rm "{{urbis_data_dir}}/urbis.zip"

    echo ""
    echo "📋 Files extracted:"
    ls -la {{urbis_data_dir}}/ 2>/dev/null
    echo ""
    echo "✅ Urbis data downloaded to {{urbis_data_dir}}"

# Import downloaded Urbis data. The tables and the view are owned by migrations (sql/migrations/urbis): the
# GeoPackage layers are loaded into urbis._raw_* tables, mapped into urbis.buildings / urbis.addresses by
# urbis.load_raw() in one transaction, and the view is refreshed concurrently, so tiles keep the previous data
# until the end.
urbis-import:
    @echo "🏙️  Urbis (Brussels) Data Import"
    @echo "=========================================="
    @echo "📅 Started at: $(date)"
    @echo ""
    @just _check-be2osm-database
    @just db-migrate
    @echo ""
    @just _urbis-load-raw
    @just _urbis-load
    @just _urbis-refresh-matview
    @just _save-import-meta urbis
    @echo ""
    @just urbis-status
    @echo ""
    @echo "✅ Urbis import complete!"

# Complete Urbis workflow (download + import)
urbis-full: urbis-download urbis-import

# Update Urbis data (no differential API: a full re-download, replacing the data in one transaction)
urbis-update: urbis-full

# Show Urbis database statistics
urbis-status:
    @echo ""
    @echo "📊 Urbis (Brussels) Statistics:"
    @{{psql_be2osm}} -c "SELECT 'Buildings' as metric, COUNT(*)::text as value, pg_size_pretty(pg_total_relation_size('urbis.buildings')) as size FROM urbis.buildings UNION ALL SELECT 'Addresses', COUNT(*)::text, pg_size_pretty(pg_total_relation_size('urbis.addresses')) FROM urbis.addresses UNION ALL SELECT 'Buildings with addresses', COUNT(*)::text, pg_size_pretty(pg_total_relation_size('urbis.buildings_with_addresses')) FROM urbis.buildings_with_addresses;" 2>/dev/null || echo "   (Urbis tables not yet created - run just db-migrate first)"
    @echo ""

# Empty the Urbis tables (the schema stays: it belongs to the migrations)
clean-urbis:
    @echo "🧹 Emptying the Urbis tables..."
    @{{psql_be2osm}} -v ON_ERROR_STOP=1 -c "TRUNCATE urbis.buildings, urbis.addresses; REFRESH MATERIALIZED VIEW urbis.buildings_with_addresses;"
    @echo "✅ Urbis tables emptied"

# Remove downloaded Urbis files
clean-urbis-downloads:
    @echo "🧹 Cleaning Urbis downloads..."
    rm -rf {{urbis_data_dir}}
    @echo "✅ Urbis downloads cleaned"

# Load the GeoPackage layers into urbis._raw_buildings, _raw_addresses, _raw_placenames and _raw_municipalities
# (FIDs preserved as inspire_id: addresses refer to buildings, streets and municipalities by them)
_urbis-load-raw:
    #!/usr/bin/env bash
    set -euo pipefail
    GPKG_FILE=$(find {{urbis_data_dir}} -name "*.gpkg" -type f 2>/dev/null | head -1)
    if [ -z "$GPKG_FILE" ]; then
        echo "❌ GeoPackage (.gpkg) file not found in {{urbis_data_dir}}: run just urbis-download first"
        exit 1
    fi
    echo "📥 Loading $GPKG_FILE..."
    PG_CONN="PG:host={{db_host}} port={{db_port}} dbname={{be2osm_db}} user={{db_user}} password={{db_password}}"
    for pair in "{{urbis_buildings_layer}}:buildings" "{{urbis_addresses_layer}}:addresses" \
        "{{urbis_placenames_layer}}:placenames" "{{urbis_municipalities_layer}}:municipalities"; do
        echo "   ${pair%%:*}"
        ogr2ogr -f PostgreSQL "$PG_CONN" "$GPKG_FILE" "${pair%%:*}" -nln "urbis._raw_${pair#*:}" -overwrite \
            -nlt PROMOTE_TO_MULTI -lco GEOMETRY_NAME=geom -lco SPATIAL_INDEX=NONE \
            -lco FID=inspire_id -preserve_fid -gt 100000 --config PG_USE_COPY YES
    done
    echo "✅ Raw Urbis tables loaded"

# Replace urbis.buildings / urbis.addresses by the raw tables, in one transaction
_urbis-load:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "🔄 Loading the raw tables into urbis.buildings / urbis.addresses..."
    {{psql_be2osm}} -X -q -v ON_ERROR_STOP=1 <<'SQL'
    SET client_min_messages = warning;
    BEGIN;
    TRUNCATE urbis.buildings, urbis.addresses;
    SELECT format('   %s buildings, %s addresses', buildings, addresses) AS loaded
    FROM urbis.load_raw('urbis._raw_buildings', 'urbis._raw_addresses', 'urbis._raw_placenames', 'urbis._raw_municipalities') \gset
    \echo :loaded
    DROP TABLE urbis._raw_buildings, urbis._raw_addresses, urbis._raw_placenames, urbis._raw_municipalities;
    COMMIT;
    ANALYZE urbis.buildings;
    ANALYZE urbis.addresses;
    SQL
    echo "✅ Urbis data loaded"

# Refresh the view; CONCURRENTLY (readers keep the previous contents) once it has been populated
_urbis-refresh-matview:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "🔄 Refreshing urbis.buildings_with_addresses..."
    POPULATED=$({{psql_be2osm}} -tAc "SELECT ispopulated FROM pg_matviews WHERE schemaname = 'urbis' AND matviewname = 'buildings_with_addresses'")
    CONCURRENTLY=""
    [ "$POPULATED" = "t" ] && CONCURRENTLY="CONCURRENTLY"
    {{psql_be2osm}} -v ON_ERROR_STOP=1 -c "REFRESH MATERIALIZED VIEW $CONCURRENTLY urbis.buildings_with_addresses;"
    echo "✅ Materialized view refreshed"

