# GRB: Get order ID from saved file
_grb-get-order-id product:
    #!/usr/bin/env bash
    FILE="{{grb_orders_dir}}/{{product}}_order.json"
    if [ -f "$FILE" ]; then
        jq -r '.member[0].orderId' "$FILE"
    fi

# GRB: Check order status
_grb-check-order-status product name:
    #!/usr/bin/env bash
    ORDER_ID=$(just _grb-get-order-id {{product}})
    if [ -n "$ORDER_ID" ] && [ "$ORDER_ID" != "null" ]; then
        echo "{{name}} - Order ID: $ORDER_ID"
        curl -s -H "x-api-key: {{grb_api_key}}" {{grb_api_base}}/orders/$ORDER_ID | jq '{status: .status, files: .files | length}'
        echo ""
    fi

# GRB: Download if order is ready
_grb-download-if-ready product order_id:
    #!/usr/bin/env bash
    if [ -z "{{order_id}}" ] || [ "{{order_id}}" = "null" ]; then
        echo "⚠️  No order found for {{product}}"
        exit 0
    fi
    echo "📥 Downloading {{product}}..."
    mkdir -p {{grb_data_dir}}/{{product}}
    ORDER_DATA=$(curl -s --retry 5 --retry-all-errors --retry-delay 10 \
        -H "x-api-key: {{grb_api_key}}" {{grb_api_base}}/orders/{{order_id}})
    STATUS=$(echo "$ORDER_DATA" | jq -r '.status')
    if [ "$STATUS" != "Processed" ] && [ "$STATUS" != "Completed" ]; then
        echo "⚠️  Not ready (Status: $STATUS)"
        exit 0
    fi
    DOWNLOAD_COUNT=$(echo "$ORDER_DATA" | jq -r '.downloads | length')
    for i in $(seq 0 $((DOWNLOAD_COUNT - 1))); do
        FILE=$(echo "$ORDER_DATA" | jq -r ".downloads[$i].name")
        DEST="{{grb_data_dir}}/{{product}}/$FILE"
        # Retry loop: resume partial downloads with curl -C -
        # The @id path is stable per order, so resuming makes sense across attempts
        MAX_ATTEMPTS=10
        for ATTEMPT in $(seq 1 $MAX_ATTEMPTS); do
            FRESH_ORDER=$(curl -s --retry 3 --retry-all-errors --retry-delay 10 \
                -H "x-api-key: {{grb_api_key}}" {{grb_api_base}}/orders/{{order_id}})
            URL=$(echo "$FRESH_ORDER" | jq -r ".downloads[$i][\"@id\"]")
            ALREADY=$(stat -c%s "$DEST" 2>/dev/null || echo 0)
            echo "   Downloading $FILE (attempt $ATTEMPT/$MAX_ATTEMPTS, $(numfmt --to=iec $ALREADY) already)..."
            CURL_PROGRESS=$([ -n "${CI:-}" ] && echo "--no-progress-meter" || echo "--progress-bar")
            curl -L $CURL_PROGRESS \
                -H "x-api-key: {{grb_api_key}}" \
                --max-time 1800 \
                -C - \
                -o "$DEST" \
                "https://download.api.vlaanderen.be$URL"
            CURL_EXIT=$?
            # Exit 33 = server rejected Range request (no resume support); clear partial file and retry
            if [ $CURL_EXIT -eq 33 ]; then
                echo "   Server does not support resume, restarting..."
                rm -f "$DEST"
                sleep 30
                continue
            fi
            if [ $CURL_EXIT -ne 0 ]; then
                echo "   curl failed (exit $CURL_EXIT), retrying in 60s..."
                sleep 60
                continue
            fi
            # Validate zip integrity before accepting
            if [[ "$FILE" == *.zip ]]; then
                if unzip -t "$DEST" > /dev/null 2>&1; then
                    break  # Valid zip
                else
                    FILE_SIZE=$(stat -c%s "$DEST" 2>/dev/null || echo 0)
                    echo "   Downloaded zip is invalid ($(numfmt --to=iec $FILE_SIZE)), clearing and retrying in 60s..."
                    rm -f "$DEST"
                    sleep 60
                fi
            else
                break  # Non-zip, no validation needed
            fi
            if [ $ATTEMPT -eq $MAX_ATTEMPTS ]; then
                echo "❌ Download failed for $FILE after $MAX_ATTEMPTS attempts" >&2
                exit 1
            fi
        done
        FILE_SIZE=$(stat -c%s "$DEST" 2>/dev/null || echo 0)
        echo "✅ Downloaded: $FILE ($(numfmt --to=iec $FILE_SIZE))"
        # Extract if ZIP
        if [[ "$FILE" == *.zip ]]; then
            echo "   📦 Extracting $FILE..."
            # unzip exit code 1 = warnings only (e.g. Windows backslash paths) — treat as success
            # exit code >= 2 = actual failure (corrupt file, read error, etc.)
            unzip -o -q "$DEST" -d "{{grb_data_dir}}/{{product}}/"
            UNZIP_EXIT=$?
            if [ $UNZIP_EXIT -ge 2 ]; then
                echo "❌ Extraction failed for $FILE (unzip exit code $UNZIP_EXIT)" >&2
                exit 1
            fi
            echo "   📁 Extracted files:"
            unzip -l "$DEST" | grep -E '\.(shp|dbf|shx|prj)$' | awk '{print "      " $4}'
            # Delete ZIP to save disk space
            rm "$DEST"
            echo "   🗑️  Deleted $FILE to save space"
        fi
    done
    echo ""
    echo "📋 All files in {{grb_data_dir}}/{{product}}:"
    find "{{grb_data_dir}}/{{product}}" -type f \( -name "*.shp" -o -name "*.dbf" \) | while read f; do echo "   $f"; done

# GRB: Wait for all orders to complete
_grb-wait-for-orders:
    #!/usr/bin/env bash
    echo "⏳ Waiting for orders to be processed..."
    echo "This may take 10-30 minutes..."
    echo ""
    while true; do
        ALL_READY=true
        for PRODUCT in gbg gba knw addresses; do
            ORDER_ID=$(just _grb-get-order-id $PRODUCT)
            if [ -n "$ORDER_ID" ] && [ "$ORDER_ID" != "null" ]; then
                STATUS=$(curl -s --retry 5 --retry-all-errors --retry-delay 10 \
                    -H "x-api-key: {{grb_api_key}}" {{grb_api_base}}/orders/$ORDER_ID | jq -r '.status')
                echo "$(date +%H:%M:%S) - $PRODUCT: $STATUS"
                if [ "$STATUS" != "Processed" ] && [ "$STATUS" != "Completed" ]; then
                    ALL_READY=false
                fi
            fi
        done
        echo ""
        if [ "$ALL_READY" = true ]; then
            echo "✅ All orders ready!"
            break
        fi
        sleep 60
    done

# GRB: Import RltGbgGebouw relationship table (polygon OIDN → building GEBOUWID)
_grb-import-gbg-gebouw-rel:
    #!/usr/bin/env bash
    echo "📊 Importing RltGbgGebouw (polygon-building relationships)..."

    # Find ALL RltGbgGebouw*.dbf files — GBG product delivers one file per province
    # Using head -1 would only import one province; loop through all like _grb-import-address-links
    FOUND=false
    FIRST=true
    for file in $(find {{grb_data_dir}} -name "RltGbgGebouw*.dbf" -type f 2>/dev/null | sort); do
        if [ -f "$file" ]; then
            FOUND=true
            LAYER_NAME=$(basename "$file" .dbf)
            echo "   Importing: $file"
            if [ "$FIRST" = true ]; then
                ogr2ogr -f PostgreSQL "PG:host={{db_host}} port={{db_port}} dbname={{be2osm_db}} user={{db_user}} password={{db_password}}" \
                    "$file" -nln grb.polygon_building_rel -overwrite \
                    -gt 100000 --config PG_USE_COPY YES \
                    -sql "SELECT OIDN as oidn, GEBOUWID as gebouw_id FROM \"$LAYER_NAME\""
                FIRST=false
            else
                ogr2ogr -f PostgreSQL "PG:host={{db_host}} port={{db_port}} dbname={{be2osm_db}} user={{db_user}} password={{db_password}}" \
                    "$file" -nln grb.polygon_building_rel -append \
                    -gt 100000 --config PG_USE_COPY YES \
                    -sql "SELECT OIDN as oidn, GEBOUWID as gebouw_id FROM \"$LAYER_NAME\""
            fi
            rm "$file"
            echo "   🗑️  Deleted $file"
        fi
    done

    if [ "$FOUND" = true ]; then
        echo "✅ Polygon-building relationships imported"
        echo "   📇 Creating index on polygon_building_rel.oidn..."
        PGPASSWORD="{{db_password}}" psql -h {{db_host}} -p {{db_port}} -U {{db_user}} -d {{be2osm_db}} -c \
            "CREATE INDEX IF NOT EXISTS idx_polygon_building_rel_oidn ON grb.polygon_building_rel(oidn);"
    else
        echo "⚠️  RltGbgGebouw*.dbf not found - gebouw_id will not be populated"
        echo "   Buildings will be aggregated by polygon geometry instead"
    fi

# GRB: Import building polygons with field mapping
_grb-import-building-polygons:
    #!/usr/bin/env bash
    echo "📊 Importing GRB building polygons..."

    # Find Gbg*.shp (handles date-stamped names like Gbg_20260129.shp)
    GBG_FILE=$(find {{grb_data_dir}} -name "Gbg*.shp" -type f 2>/dev/null | head -1)

    if [ -n "$GBG_FILE" ] && [ -f "$GBG_FILE" ]; then
        echo "   Found: $GBG_FILE"
        echo "   This may take several minutes for 5M+ polygons..."
        # Import directly - ogr2ogr handles geometry automatically when not using -sql
        # We'll use field renaming flags or post-import SQL updates
        ogr2ogr -f PostgreSQL "PG:host={{db_host}} port={{db_port}} dbname={{be2osm_db}} user={{db_user}} password={{db_password}}" \
            "$GBG_FILE" -nln grb.building_polygons_raw -overwrite -t_srs EPSG:4326 \
            -gt 100000 --config PG_USE_COPY YES \
            -lco GEOMETRY_NAME=geom -lco SPATIAL_INDEX=OFF

        echo "   Transforming imported data..."
        PGPASSWORD="{{db_password}}" psql -h {{db_host}} -p {{db_port}} -U {{db_user}} -d {{be2osm_db}} -c "
            INSERT INTO grb.building_polygons (oidn, uidn, type_code, type_label, area_m2, length_m, version, origin_code, origin_label, opndatum_raw, geom)
            SELECT
                oidn::bigint,
                uidn::bigint,
                type::integer as type_code,
                lbltype as type_label,
                oppervl::real as area_m2,
                lengte::real as length_m,
                versie::integer as version,
                bgninv::integer as origin_code,
                lblbgninv as origin_label,
                opndatum as opndatum_raw,
                geom
            FROM grb.building_polygons_raw
            ON CONFLICT (oidn) DO NOTHING;
            DROP TABLE IF EXISTS grb.building_polygons_raw;
        "
        echo "✅ Building polygons imported"

        # Convert OPNDATUM to proper DATE (two passes: YYYY-MM-DD then DD/MM/YYYY)
        echo "   Converting survey_date..."
        PGPASSWORD="{{db_password}}" psql -h {{db_host}} -p {{db_port}} -U {{db_user}} -d {{be2osm_db}} -c \
            "UPDATE grb.building_polygons SET survey_date = opndatum_raw::date WHERE opndatum_raw IS NOT NULL AND survey_date IS NULL AND opndatum_raw ~ '^\d{4}-\d{2}-\d{2}$';"
        PGPASSWORD="{{db_password}}" psql -h {{db_host}} -p {{db_port}} -U {{db_user}} -d {{be2osm_db}} -c \
            "UPDATE grb.building_polygons SET survey_date = TO_DATE(opndatum_raw, 'DD/MM/YYYY') WHERE opndatum_raw IS NOT NULL AND survey_date IS NULL AND opndatum_raw ~ '^\d{2}/\d{2}/\d{4}$';"
        echo "✅ Survey dates converted"

        # Create index for faster joins
        echo "   📇 Creating index on building_polygons.oidn..."
        PGPASSWORD="{{db_password}}" psql -h {{db_host}} -p {{db_port}} -U {{db_user}} -d {{be2osm_db}} -c \
            "CREATE INDEX IF NOT EXISTS idx_building_polygons_oidn ON grb.building_polygons(oidn);"

        # Clean up gbg directory to save disk space
        echo "   🗑️  Cleaning up gbg data..."
        rm -rf {{grb_data_dir}}/gbg
    else
        echo "❌ Gbg*.shp not found in {{grb_data_dir}}"
        exit 1
    fi

