# Show GRB database statistics
grb-status:
    @echo "📈 GRB Database Statistics:"
    @echo ""
    @{{psql_be2osm}} -c "SELECT 'Building polygons' as metric, COUNT(*)::text as value, pg_size_pretty(pg_total_relation_size('grb.building_polygons')) as size FROM grb.building_polygons UNION ALL SELECT '  - with gebouw_id', COUNT(*)::text, '' FROM grb.building_polygons WHERE gebouw_id IS NOT NULL UNION ALL SELECT '  - with survey_date', COUNT(*)::text, '' FROM grb.building_polygons WHERE survey_date IS NOT NULL UNION ALL SELECT 'Kunstwerken (KNW)', COALESCE((SELECT n_live_tup::bigint::text FROM pg_stat_user_tables WHERE schemaname='grb' AND relname='kunstwerken'), '0'), COALESCE(pg_size_pretty(pg_total_relation_size(to_regclass('grb.kunstwerken'))), '') UNION ALL SELECT 'Polygon-building relations', COUNT(*)::text, pg_size_pretty(pg_total_relation_size('grb.polygon_building_rel')) FROM grb.polygon_building_rel UNION ALL SELECT 'Buildings (aggregated)', COUNT(*)::text, pg_size_pretty(pg_total_relation_size('grb.buildings')) FROM grb.buildings UNION ALL SELECT 'Addresses', COUNT(*)::text, pg_size_pretty(pg_total_relation_size('grb.addresses')) FROM grb.addresses UNION ALL SELECT 'Address-building links', COUNT(*)::text, pg_size_pretty(pg_total_relation_size('grb.address_building_links')) FROM grb.address_building_links;"
    @echo ""

