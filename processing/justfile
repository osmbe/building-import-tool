# GRB: Get order ID from saved file
_grb-get-order-id product:
    #!/usr/bin/env bash
    FILE="{{grb_orders_dir}}/{{product}}_order.json"
    if [ -f "$FILE" ]; then
        jq -r '.member[0].orderId' "$FILE"
    fi

# GRB: Check order status
_grb-check-order-status product name:
    #!/usr/bin/env bash
    ORDER_ID=$(just _grb-get-order-id {{product}})
    if [ -n "$ORDER_ID" ] && [ "$ORDER_ID" != "null" ]; then
        echo "{{name}} - Order ID: $ORDER_ID"
        curl -s -H "x-api-key: {{grb_api_key}}" {{grb_api_base}}/orders/$ORDER_ID | jq '{status: .status, files: .files | length}'
        echo ""
    fi

# GRB: Download if order is ready
_grb-download-if-ready product order_id:
    #!/usr/bin/env bash
    if [ -z "{{order_id}}" ] || [ "{{order_id}}" = "null" ]; then
        echo "⚠️  No order found for {{product}}"
        exit 0
    fi
    echo "📥 Downloading {{product}}..."
    mkdir -p {{grb_data_dir}}/{{product}}
    ORDER_DATA=$(curl -s --retry 5 --retry-all-errors --retry-delay 10 \
        -H "x-api-key: {{grb_api_key}}" {{grb_api_base}}/orders/{{order_id}})
    STATUS=$(echo "$ORDER_DATA" | jq -r '.status')
    if [ "$STATUS" != "Processed" ] && [ "$STATUS" != "Completed" ]; then
        echo "⚠️  Not ready (Status: $STATUS)"
        exit 0
    fi
    DOWNLOAD_COUNT=$(echo "$ORDER_DATA" | jq -r '.downloads | length')
    if [ "$DOWNLOAD_COUNT" = "0" ]; then
        echo "❌ No files available for {{product}} (order {{order_id}})" >&2
        exit 1
    fi

    MAX_ATTEMPTS={{grb_download_max_attempts}}
    MAX_TIME_SEC={{grb_download_max_time_sec}}
    RETRY_SLEEP_SEC={{grb_download_retry_sleep_sec}}
    echo "   settings: max_attempts=${MAX_ATTEMPTS}, max_time=${MAX_TIME_SEC}s, retry_sleep=${RETRY_SLEEP_SEC}s"

    for i in $(seq 0 $((DOWNLOAD_COUNT - 1))); do
        FILE=$(echo "$ORDER_DATA" | jq -r ".downloads[$i].name")
        DEST="{{grb_data_dir}}/{{product}}/$FILE"
        # Retry loop: resume partial downloads with curl -C -
        # The @id path is stable per order, so resuming makes sense across attempts
        DOWNLOAD_OK=false
        for ATTEMPT in $(seq 1 $MAX_ATTEMPTS); do
            FRESH_ORDER=$(curl -s --retry 3 --retry-all-errors --retry-delay 10 \
                -H "x-api-key: {{grb_api_key}}" {{grb_api_base}}/orders/{{order_id}})
            URL=$(echo "$FRESH_ORDER" | jq -r ".downloads[$i][\"@id\"]")
            ALREADY=$(stat -c%s "$DEST" 2>/dev/null || echo 0)
            echo "   Downloading $FILE (attempt $ATTEMPT/$MAX_ATTEMPTS, $(numfmt --to=iec $ALREADY) already)..."
            CURL_PROGRESS=$([ -n "${CI:-}" ] && echo "--no-progress-meter" || echo "--progress-bar")
            if [ "$ALREADY" -gt 0 ]; then
                curl -L $CURL_PROGRESS \
                    -H "x-api-key: {{grb_api_key}}" \
                    --max-time "$MAX_TIME_SEC" \
                    -C - \
                    -o "$DEST" \
                    "https://download.api.vlaanderen.be$URL"
            else
                curl -L $CURL_PROGRESS \
                    -H "x-api-key: {{grb_api_key}}" \
                    --max-time "$MAX_TIME_SEC" \
                    -o "$DEST" \
                    "https://download.api.vlaanderen.be$URL"
            fi
            CURL_EXIT=$?

            # Exit 33 = server rejected Range request (no resume support).
            # Fall back to a full re-download in the same attempt.
            if [ $CURL_EXIT -eq 33 ]; then
                echo "   Server rejected resume, retrying same attempt without resume..."
                rm -f "$DEST"
                curl -L $CURL_PROGRESS \
                    -H "x-api-key: {{grb_api_key}}" \
                    --max-time "$MAX_TIME_SEC" \
                    -o "$DEST" \
                    "https://download.api.vlaanderen.be$URL"
                CURL_EXIT=$?
            fi

            if [ $CURL_EXIT -ne 0 ]; then
                echo "   curl failed (exit $CURL_EXIT), retrying in ${RETRY_SLEEP_SEC}s..."
                if [ $ATTEMPT -eq $MAX_ATTEMPTS ]; then
                    echo "❌ Download failed for $FILE after $MAX_ATTEMPTS attempts" >&2
                    exit 1
                fi
                sleep "$RETRY_SLEEP_SEC"
                continue
            fi
            # Validate zip integrity before accepting
            if [[ "$FILE" == *.zip ]]; then
                if unzip -t "$DEST" > /dev/null 2>&1; then
                    DOWNLOAD_OK=true
                    break  # Valid zip
                else
                    FILE_SIZE=$(stat -c%s "$DEST" 2>/dev/null || echo 0)
                    echo "   Downloaded zip is invalid ($(numfmt --to=iec $FILE_SIZE)), clearing and retrying in ${RETRY_SLEEP_SEC}s..."
                    rm -f "$DEST"
                    if [ $ATTEMPT -eq $MAX_ATTEMPTS ]; then
                        echo "❌ Download failed for $FILE after $MAX_ATTEMPTS attempts (invalid zip)" >&2
                        exit 1
                    fi
                    sleep "$RETRY_SLEEP_SEC"
                fi
            else
                DOWNLOAD_OK=true
                break  # Non-zip, no validation needed
            fi
        done

        if [ "$DOWNLOAD_OK" != "true" ]; then
            echo "❌ Download failed for $FILE after $MAX_ATTEMPTS attempts" >&2
            exit 1
        fi

        FILE_SIZE=$(stat -c%s "$DEST" 2>/dev/null || echo 0)
        echo "✅ Downloaded: $FILE ($(numfmt --to=iec $FILE_SIZE))"
        # Extract if ZIP
        if [[ "$FILE" == *.zip ]]; then
            echo "   📦 Extracting $FILE..."
            # unzip exit code 1 = warnings only (e.g. Windows backslash paths) — treat as success
            # exit code >= 2 = actual failure (corrupt file, read error, etc.)
            unzip -o -q "$DEST" -d "{{grb_data_dir}}/{{product}}/"
            UNZIP_EXIT=$?
            if [ $UNZIP_EXIT -ge 2 ]; then
                echo "❌ Extraction failed for $FILE (unzip exit code $UNZIP_EXIT)" >&2
                exit 1
            fi
            echo "   📁 Extracted files:"
            unzip -l "$DEST" | grep -E '\.(shp|dbf|shx|prj)$' | awk '{print "      " $4}'
            # Delete ZIP to save disk space
            rm "$DEST"
            echo "   🗑️  Deleted $FILE to save space"
        fi
    done
    echo ""
    echo "📋 All files in {{grb_data_dir}}/{{product}}:"
    find "{{grb_data_dir}}/{{product}}" -type f \( -name "*.shp" -o -name "*.dbf" \) | while read f; do echo "   $f"; done

# GRB: Wait for all orders to complete
_grb-wait-for-orders:
    #!/usr/bin/env bash
    echo "⏳ Waiting for orders to be processed..."
    echo "This may take 10-30 minutes..."
    echo ""
    while true; do
        ALL_READY=true
        for PRODUCT in gbg gba knw addresses; do
            ORDER_ID=$(just _grb-get-order-id $PRODUCT)
            if [ -n "$ORDER_ID" ] && [ "$ORDER_ID" != "null" ]; then
                STATUS=$(curl -s --retry 5 --retry-all-errors --retry-delay 10 \
                    -H "x-api-key: {{grb_api_key}}" {{grb_api_base}}/orders/$ORDER_ID | jq -r '.status')
                echo "$(date +%H:%M:%S) - $PRODUCT: $STATUS"
                if [ "$STATUS" != "Processed" ] && [ "$STATUS" != "Completed" ]; then
                    ALL_READY=false
                fi
            fi
        done
        echo ""
        if [ "$ALL_READY" = true ]; then
            echo "✅ All orders ready!"
            break
        fi
        sleep 60
    done

# GRB: Import RltGbgGebouw relationship table (polygon OIDN → building GEBOUWID)
_grb-import-gbg-gebouw-rel:
    #!/usr/bin/env bash
    echo "📊 Importing RltGbgGebouw (polygon-building relationships)..."

    # Find ALL RltGbgGebouw*.dbf files — GBG product delivers one file per province
    # Using head -1 would only import one province; loop through all like _grb-import-address-links
    FOUND=false
    FIRST=true
    for file in $(find {{grb_data_dir}} -name "RltGbgGebouw*.dbf" -type f 2>/dev/null | sort); do
        if [ -f "$file" ]; then
            FOUND=true
            LAYER_NAME=$(basename "$file" .dbf)
            echo "   Importing: $file"
            if [ "$FIRST" = true ]; then
                ogr2ogr -f PostgreSQL "PG:host={{db_host}} port={{db_port}} dbname={{be2osm_db}} user={{db_user}} password={{db_password}}" \
                    "$file" -nln grb.polygon_building_rel -overwrite \
                    -gt 100000 --config PG_USE_COPY YES \
                    -sql "SELECT OIDN as oidn, GEBOUWID as gebouw_id FROM \"$LAYER_NAME\""
                FIRST=false
            else
                ogr2ogr -f PostgreSQL "PG:host={{db_host}} port={{db_port}} dbname={{be2osm_db}} user={{db_user}} password={{db_password}}" \
                    "$file" -nln grb.polygon_building_rel -append \
                    -gt 100000 --config PG_USE_COPY YES \
                    -sql "SELECT OIDN as oidn, GEBOUWID as gebouw_id FROM \"$LAYER_NAME\""
            fi
            rm "$file"
            echo "   🗑️  Deleted $file"
        fi
    done

    if [ "$FOUND" = true ]; then
        echo "✅ Polygon-building relationships imported"
        echo "   📇 Creating index on polygon_building_rel.oidn..."
        PGPASSWORD="{{db_password}}" psql -h {{db_host}} -p {{db_port}} -U {{db_user}} -d {{be2osm_db}} -c \
            "CREATE INDEX IF NOT EXISTS idx_polygon_building_rel_oidn ON grb.polygon_building_rel(oidn);"
    else
        echo "⚠️  RltGbgGebouw*.dbf not found - gebouw_id will not be populated"
        echo "   Buildings will be aggregated by polygon geometry instead"
    fi

# GRB: Import building polygons with field mapping
_grb-import-building-polygons:
    #!/usr/bin/env bash
    echo "📊 Importing GRB building polygons..."

    # Find Gbg*.shp (handles date-stamped names like Gbg_20260129.shp)
    GBG_FILE=$(find {{grb_data_dir}} -name "Gbg*.shp" -type f 2>/dev/null | head -1)

    if [ -n "$GBG_FILE" ] && [ -f "$GBG_FILE" ]; then
        echo "   Found: $GBG_FILE"
        echo "   This may take several minutes for 5M+ polygons..."
        # Import directly - ogr2ogr handles geometry automatically when not using -sql
        # We'll use field renaming flags or post-import SQL updates
        ogr2ogr -f PostgreSQL "PG:host={{db_host}} port={{db_port}} dbname={{be2osm_db}} user={{db_user}} password={{db_password}}" \
            "$GBG_FILE" -nln grb.building_polygons_raw -overwrite -t_srs EPSG:4326 \
            -gt 100000 --config PG_USE_COPY YES \
            -lco GEOMETRY_NAME=geom -lco SPATIAL_INDEX=OFF

        echo "   Transforming imported data..."
        PGPASSWORD="{{db_password}}" psql -h {{db_host}} -p {{db_port}} -U {{db_user}} -d {{be2osm_db}} -c "
            INSERT INTO grb.building_polygons (entity, oidn, uidn, type_code, type_label, area_m2, length_m, version, origin_code, origin_label, opndatum_raw, geom)
            SELECT
                'Gbg',
                oidn::bigint,
                uidn::bigint,
                type::integer as type_code,
                lbltype as type_label,
                oppervl::real as area_m2,
                lengte::real as length_m,
                versie::integer as version,
                bgninv::integer as origin_code,
                lblbgninv as origin_label,
                opndatum as opndatum_raw,
                geom
            FROM grb.building_polygons_raw
            ON CONFLICT (entity, oidn) DO NOTHING;
            DROP TABLE IF EXISTS grb.building_polygons_raw;
        "
        echo "✅ Building polygons imported"

        # Convert OPNDATUM to proper DATE (two passes: YYYY-MM-DD then DD/MM/YYYY)
        echo "   Converting survey_date..."
        PGPASSWORD="{{db_password}}" psql -h {{db_host}} -p {{db_port}} -U {{db_user}} -d {{be2osm_db}} -c \
            "UPDATE grb.building_polygons SET survey_date = opndatum_raw::date WHERE opndatum_raw IS NOT NULL AND survey_date IS NULL AND opndatum_raw ~ '^\d{4}-\d{2}-\d{2}$';"
        PGPASSWORD="{{db_password}}" psql -h {{db_host}} -p {{db_port}} -U {{db_user}} -d {{be2osm_db}} -c \
            "UPDATE grb.building_polygons SET survey_date = TO_DATE(opndatum_raw, 'DD/MM/YYYY') WHERE opndatum_raw IS NOT NULL AND survey_date IS NULL AND opndatum_raw ~ '^\d{2}/\d{2}/\d{4}$';"
        echo "✅ Survey dates converted"

        # Create index for faster joins
        echo "   📇 Creating index on building_polygons.oidn..."
        PGPASSWORD="{{db_password}}" psql -h {{db_host}} -p {{db_port}} -U {{db_user}} -d {{be2osm_db}} -c \
            "CREATE INDEX IF NOT EXISTS idx_building_polygons_oidn ON grb.building_polygons(oidn);"

        # Clean up gbg directory to save disk space
        echo "   🗑️  Cleaning up gbg data..."
        rm -rf {{grb_data_dir}}/gbg
    else
        echo "❌ Gbg*.shp not found in {{grb_data_dir}}"
        exit 1
    fi

# GRB: Import GBA (Gebouwaanhorigheid / building attachments) into building_polygons
# GBA has the same field structure as GBG and is appended to the same table with entity 'Gba'.
# OIDNs are only unique per entity, so a GBA polygon may share its OIDN with a GBG polygon: the
# unique key is (entity, oidn). gebouw_id will be NULL for these polygons (no RltGbaGebouw file).
_grb-import-gba:
    #!/usr/bin/env bash
    GBA_FILE=$(find {{grb_data_dir}} -path "*/gba/*" -name "Gba*.shp" -type f 2>/dev/null | head -1)
    if [ -z "$GBA_FILE" ]; then
        echo "⚠️  Gba*.shp not found — skipping GBA import"
        exit 0
    fi
    echo "📊 Importing GBA building attachments (Gebouwaanhorigheid)..."
    echo "   Found: $GBA_FILE"
    ogr2ogr -f PostgreSQL "PG:host={{db_host}} port={{db_port}} dbname={{be2osm_db}} user={{db_user}} password={{db_password}}" \
        "$GBA_FILE" -nln grb.building_polygons_raw -overwrite -t_srs EPSG:4326 \
        -gt 100000 --config PG_USE_COPY YES \
        -lco GEOMETRY_NAME=geom -lco SPATIAL_INDEX=OFF
    PGPASSWORD="{{db_password}}" psql -h {{db_host}} -p {{db_port}} -U {{db_user}} -d {{be2osm_db}} -c "
        INSERT INTO grb.building_polygons (entity, oidn, uidn, type_code, type_label, area_m2, length_m, version, origin_code, origin_label, opndatum_raw, geom)
        SELECT
            'Gba',
            oidn::bigint,
            uidn::bigint,
            type::integer as type_code,
            lbltype as type_label,
            oppervl::real as area_m2,
            lengte::real as length_m,
            versie::integer as version,
            bgninv::integer as origin_code,
            lblbgninv as origin_label,
            opndatum as opndatum_raw,
            geom
        FROM grb.building_polygons_raw
        ON CONFLICT (entity, oidn) DO NOTHING;
        DROP TABLE IF EXISTS grb.building_polygons_raw;
    "
    # Convert OPNDATUM to proper DATE (two passes: YYYY-MM-DD then DD/MM/YYYY)
    PGPASSWORD="{{db_password}}" psql -h {{db_host}} -p {{db_port}} -U {{db_user}} -d {{be2osm_db}} -c \
        "UPDATE grb.building_polygons SET survey_date = opndatum_raw::date WHERE entity = 'Gba' AND opndatum_raw IS NOT NULL AND survey_date IS NULL AND opndatum_raw ~ '^\d{4}-\d{2}-\d{2}$';"
    PGPASSWORD="{{db_password}}" psql -h {{db_host}} -p {{db_port}} -U {{db_user}} -d {{be2osm_db}} -c \
        "UPDATE grb.building_polygons SET survey_date = TO_DATE(opndatum_raw, 'DD/MM/YYYY') WHERE entity = 'Gba' AND opndatum_raw IS NOT NULL AND survey_date IS NULL AND opndatum_raw ~ '^\d{2}/\d{2}/\d{4}$';"
    echo "✅ GBA building attachments imported"
    echo "   🗑️  Cleaning up gba data..."
    rm -rf {{grb_data_dir}}/gba

# GRB: Import KNW (Kunstwerken) into dedicated kunstwerken table
_grb-import-knw:
    #!/usr/bin/env bash
    FIRST=true
    FOUND=false

    for KNW_FILE in $(find {{grb_data_dir}} -path "*/knw/*" \( -name "Knw*.shp" -o -name "Gvl*.shp" \) -type f 2>/dev/null | sort); do
      if [ ! -f "$KNW_FILE" ]; then
        continue
      fi

      FOUND=true
      echo "📊 Importing KNW kunstwerken..."
      echo "   Found: $KNW_FILE"

      if [ "$FIRST" = true ]; then
        ogr2ogr -f PostgreSQL "PG:host={{db_host}} port={{db_port}} dbname={{be2osm_db}} user={{db_user}} password={{db_password}}" \
            "$KNW_FILE" -nln grb.kunstwerken_raw -overwrite -t_srs EPSG:4326 \
            -gt 100000 --config PG_USE_COPY YES \
            -lco GEOMETRY_NAME=geom -lco SPATIAL_INDEX=OFF
        FIRST=false
      else
        ogr2ogr -f PostgreSQL "PG:host={{db_host}} port={{db_port}} dbname={{be2osm_db}} user={{db_user}} password={{db_password}}" \
            "$KNW_FILE" -nln grb.kunstwerken_raw -append -t_srs EPSG:4326 \
            -gt 100000 --config PG_USE_COPY YES
      fi
    done

    if [ "$FOUND" = false ]; then
        echo "⚠️  KNW shapefile not found (Knw*.shp or Gvl*.shp) — skipping KNW import"
        exit 0
    fi

    PGPASSWORD="{{db_password}}" psql -h {{db_host}} -p {{db_port}} -U {{db_user}} -d {{be2osm_db}} -c "
        INSERT INTO grb.kunstwerken (oidn, uidn, type_code, type_label, area_m2, length_m, version, origin_code, origin_label, opndatum_raw, entity, geom)
        SELECT
            oidn::bigint,
            uidn::bigint,
            type::integer as type_code,
            lbltype as type_label,
            CASE
                WHEN GeometryType(geom) LIKE 'POLYGON%' OR GeometryType(geom) LIKE 'MULTIPOLYGON%'
                THEN ST_Area(geom::geography)::real
                ELSE NULL
            END as area_m2,
            lengte::real as length_m,
            versie::integer as version,
            bgninv::integer as origin_code,
            lblbgninv as origin_label,
            opndatum as opndatum_raw,
            'Knw'::varchar(8) as entity,
            ST_MakeValid(geom)::geometry(Geometry, 4326)
        FROM grb.kunstwerken_raw
        WHERE NOT ST_IsEmpty(ST_MakeValid(geom))
        ON CONFLICT (oidn) DO NOTHING;
        DROP TABLE IF EXISTS grb.kunstwerken_raw;
    "

    echo "   Converting survey_date..."
    PGPASSWORD="{{db_password}}" psql -h {{db_host}} -p {{db_port}} -U {{db_user}} -d {{be2osm_db}} -c \
        "UPDATE grb.kunstwerken SET survey_date = opndatum_raw::date WHERE opndatum_raw IS NOT NULL AND survey_date IS NULL AND opndatum_raw ~ '^\\d{4}-\\d{2}-\\d{2}$';"
    PGPASSWORD="{{db_password}}" psql -h {{db_host}} -p {{db_port}} -U {{db_user}} -d {{be2osm_db}} -c \
        "UPDATE grb.kunstwerken SET survey_date = TO_DATE(opndatum_raw, 'DD/MM/YYYY') WHERE opndatum_raw IS NOT NULL AND survey_date IS NULL AND opndatum_raw ~ '^\\d{2}/\\d{2}/\\d{4}$';"

    echo "✅ KNW kunstwerken imported"
    echo "   🗑️  Cleaning up knw data..."
    rm -rf {{grb_data_dir}}/knw

# GRB: Update gebouw_id in building_polygons from relationship table
_grb-update-gebouw-ids:
    #!/usr/bin/env bash
    set -e

    echo "📊 Pre-populating buildings table with unique gebouw_ids..."
    PGPASSWORD="{{db_password}}" psql -h "{{db_host}}" -p "{{db_port}}" -U "{{db_user}}" -d be2osm -c \
        "INSERT INTO grb.buildings (gebouw_id) SELECT DISTINCT gebouw_id FROM grb.polygon_building_rel WHERE gebouw_id IS NOT NULL ON CONFLICT (gebouw_id) DO NOTHING;"
    echo "✅ Buildings table pre-populated"

    echo "📊 Analyzing tables for query optimization..."
    PGPASSWORD="{{db_password}}" psql -h "{{db_host}}" -p "{{db_port}}" -U "{{db_user}}" -d be2osm -c \
        "ANALYZE grb.building_polygons; ANALYZE grb.polygon_building_rel;"

    echo "📊 Updating gebouw_id from relationship table..."
    PGPASSWORD="{{db_password}}" psql -h "{{db_host}}" -p "{{db_port}}" -U "{{db_user}}" -d be2osm -c "
        UPDATE grb.building_polygons bp
        SET gebouw_id = rel.gebouw_id
        FROM grb.polygon_building_rel rel
        WHERE bp.oidn = rel.oidn
          AND bp.entity = 'Gbg'  -- RltGbgGebouw only references GBG polygon OIDNs
          AND bp.gebouw_id IS NULL;
    "
    echo "✅ gebouw_id updated"
    PGPASSWORD="{{db_password}}" psql -h "{{db_host}}" -p "{{db_port}}" -U "{{db_user}}" -d be2osm -c \
        "SELECT 'Polygons with gebouw_id' as metric, COUNT(*)::text as value FROM grb.building_polygons WHERE gebouw_id IS NOT NULL UNION ALL SELECT 'Polygons without gebouw_id', COUNT(*)::text FROM grb.building_polygons WHERE gebouw_id IS NULL;"

# GRB: Import addresses
_grb-import-addresses:
    #!/usr/bin/env bash
    echo "📊 Importing addresses..."

    # Find address shapefiles and import to raw table first
    FIRST=true
    for file in $(find {{grb_data_dir}} -path "*/addresses/*" -name "Adres*.shp" -type f 2>/dev/null); do
        if [ -f "$file" ]; then
            LAYER=$(basename "$file" .shp)
            echo "   Importing: $LAYER"
            if [ "$FIRST" = true ]; then
                ogr2ogr -f PostgreSQL "PG:host={{db_host}} port={{db_port}} dbname={{be2osm_db}} user={{db_user}} password={{db_password}}" \
                    "$file" -nln grb.addresses_raw -overwrite -t_srs EPSG:4326 \
                    -gt 100000 --config PG_USE_COPY YES \
                    -lco GEOMETRY_NAME=geom -lco SPATIAL_INDEX=OFF
                FIRST=false
            else
                ogr2ogr -f PostgreSQL "PG:host={{db_host}} port={{db_port}} dbname={{be2osm_db}} user={{db_user}} password={{db_password}}" \
                    "$file" -nln grb.addresses_raw -append -t_srs EPSG:4326 \
                    -gt 100000 --config PG_USE_COPY YES
            fi
        fi
    done

    echo "   Transforming imported data..."
    PGPASSWORD="{{db_password}}" psql -h {{db_host}} -p {{db_port}} -U {{db_user}} -d {{be2osm_db}} -c "
        INSERT INTO grb.addresses (oidn, adres_id, id_string, street_id, street_name, house_number, box_number, postcode, nis_code, municipality, full_address, position_spec_code, position_spec, method_code, method, status_code, status, official_assignment_code, official_assignment, origin_code, origin_label, version_id, version, begin_date, version_date, geom)
        SELECT
            oidn::bigint,
            adresid::bigint as adres_id,
            id as id_string,
            straatnmid::bigint as street_id,
            straatnm as street_name,
            huisnr as house_number,
            busnr as box_number,
            postcode,
            niscode as nis_code,
            gemeente as municipality,
            adresnaam as full_address,
            posspec::integer as position_spec_code,
            lblposspec as position_spec,
            methode::integer as method_code,
            lblmethode as method,
            status::integer as status_code,
            lblstatus as status,
            offtoeg::integer as official_assignment_code,
            lblofftoeg as official_assignment,
            bgninv::integer as origin_code,
            lblbgninv as origin_label,
            versieid as version_id,
            versie::integer as version,
            begindatum::date as begin_date,
            versdatum::date as version_date,
            geom
        FROM grb.addresses_raw
        ON CONFLICT (oidn) DO NOTHING;
        DROP TABLE IF EXISTS grb.addresses_raw;
    "
    echo "✅ Addresses imported"

# GRB: Import address-building links
_grb-import-address-links:
    #!/usr/bin/env bash
    echo "📊 Importing address-building links..."

    # Drop FK constraint temporarily: some adres_ids in link files reference deprecated
    # addresses no longer present in the GRB address shapefile. Without this, PG_USE_COPY
    # rolls back entire 100K-row batches on the first FK violation, losing valid rows.
    PGPASSWORD="{{db_password}}" psql -h {{db_host}} -p {{db_port}} -U {{db_user}} -d {{be2osm_db}} -c \
        "ALTER TABLE grb.address_building_links DROP CONSTRAINT IF EXISTS fk_address_building_links_adres_id;"

    # Find RltAdresGebouw*.dbf files (exclude Lkt lookup tables)
    # GRB-Adres product (10445) delivers multiple files: RltAdresGebouw.dbf, RltAdresGebouw_1.dbf, etc.
    for file in $(find {{grb_data_dir}} -name "RltAdresGebouw*.dbf" -type f 2>/dev/null | grep -v "Lkt" | sort); do
        if [ -f "$file" ]; then
            echo "   Importing: $file"
            LAYER_NAME=$(basename "$file" .dbf)
            ogr2ogr -f PostgreSQL "PG:host={{db_host}} port={{db_port}} dbname={{be2osm_db}} user={{db_user}} password={{db_password}}" \
                "$file" -nln grb.address_building_links -append \
                -gt 100000 --config PG_USE_COPY YES \
                -sql "SELECT
                    ADRESID as adres_id,
                    GEBOUWID as building_object_id,
                    LBLTYPE as object_type
                FROM \"$LAYER_NAME\""
        fi
    done

    # Remove links whose adres_id has no matching address (deprecated/removed addresses)
    echo "   Cleaning up orphan links (adres_id not in addresses)..."
    PGPASSWORD="{{db_password}}" psql -h {{db_host}} -p {{db_port}} -U {{db_user}} -d {{be2osm_db}} -c \
        "DELETE FROM grb.address_building_links abl
         WHERE NOT EXISTS (SELECT 1 FROM grb.addresses a WHERE a.adres_id = abl.adres_id);"

    # Re-add FK constraint now that orphan links are removed
    PGPASSWORD="{{db_password}}" psql -h {{db_host}} -p {{db_port}} -U {{db_user}} -d {{be2osm_db}} -c \
        "ALTER TABLE grb.address_building_links ADD CONSTRAINT fk_address_building_links_adres_id
         FOREIGN KEY (adres_id) REFERENCES grb.addresses(adres_id);"

    echo "✅ Address links imported"

    # Clean up data directories to save disk space
    echo "   🗑️  Cleaning up address-links and addresses data..."
    rm -rf {{grb_data_dir}}/address-links
    rm -rf {{grb_data_dir}}/addresses

# GRB: Aggregate building polygons into buildings (batched to avoid OOM)
_grb-aggregate-buildings:
    #!/usr/bin/env bash
    set -e
    echo "📊 Aggregating building polygons (batched)..."

    BATCH_SIZE=100000

    TOTAL=$(PGPASSWORD="{{db_password}}" psql -h "{{db_host}}" -p "{{db_port}}" -U "{{db_user}}" -d be2osm -t -A -c \
        "SELECT COUNT(DISTINCT gebouw_id) FROM grb.building_polygons WHERE gebouw_id IS NOT NULL;")
    echo "   Total unique gebouw_ids: $TOTAL"

    # Cursor-based pagination: track the last processed gebouw_id instead of OFFSET.
    # OFFSET scans grow with each batch (O(n²) total); cursor stays O(n).
    LAST_ID=0
    BATCH_NUM=1
    TOTAL_BATCHES=$(( (TOTAL + BATCH_SIZE - 1) / BATCH_SIZE ))

    while true; do
        BATCH_MAX=$(PGPASSWORD="{{db_password}}" psql -h "{{db_host}}" -p "{{db_port}}" -U "{{db_user}}" -d be2osm -t -A -c \
            "SELECT MAX(g) FROM (SELECT gebouw_id AS g FROM grb.building_polygons WHERE gebouw_id > $LAST_ID ORDER BY gebouw_id LIMIT $BATCH_SIZE) sub;")
        [ -z "$BATCH_MAX" ] || [ "$BATCH_MAX" = "" ] && break

        PERCENT=$(( BATCH_NUM * 100 / TOTAL_BATCHES ))
        echo "   Batch $BATCH_NUM/$TOTAL_BATCHES: gebouw_id $((LAST_ID + 1))-$BATCH_MAX ($PERCENT%)..."

        PGPASSWORD="{{db_password}}" psql -h "{{db_host}}" -p "{{db_port}}" -U "{{db_user}}" -d be2osm -c "
            INSERT INTO grb.buildings (gebouw_id, polygon_count, total_area_m2, type_label, geom)
            SELECT
                bp.gebouw_id,
                COUNT(*) as polygon_count,
                SUM(bp.area_m2)::real as total_area_m2,
                MAX(bp.type_label) as type_label,
                ST_Union(bp.geom) as geom
            FROM grb.building_polygons bp
            WHERE bp.gebouw_id > $LAST_ID AND bp.gebouw_id <= $BATCH_MAX
            GROUP BY bp.gebouw_id
            ON CONFLICT (gebouw_id) DO UPDATE SET
                polygon_count = EXCLUDED.polygon_count,
                total_area_m2 = EXCLUDED.total_area_m2,
                type_label = EXCLUDED.type_label,
                geom = EXCLUDED.geom;
        "

        LAST_ID=$BATCH_MAX
        BATCH_NUM=$((BATCH_NUM + 1))
    done

    echo "✅ Buildings aggregated"

# GRB: Refresh materialized view
_grb-refresh-materialized-view:
    #!/usr/bin/env bash
    set -e
    echo "📊 Refreshing materialized view..."
    echo "   This joins building_polygons with buildings and addresses..."

    # (Re)creates the view if missing or outdated, e.g. after a restore onto an old schema
    just db-migrate

    # Show expected row count
    POLYGONS=$(PGPASSWORD="{{db_password}}" psql -h "{{db_host}}" -p "{{db_port}}" -U "{{db_user}}" -d be2osm -t -A -c \
        "SELECT COUNT(*) FROM grb.building_polygons;")
    echo "   Expected rows: ~$POLYGONS (one per polygon)"

    START_TIME=$(date +%s)

    # CONCURRENTLY keeps the view (and the GRB tiles) readable while it refreshes; it needs a populated view
    POPULATED=$(PGPASSWORD="{{db_password}}" psql -h "{{db_host}}" -p "{{db_port}}" -U "{{db_user}}" -d be2osm -t -A -c \
        "SELECT ispopulated FROM pg_matviews WHERE schemaname = 'grb' AND matviewname = 'buildings_with_addresses';")
    CONCURRENTLY=""
    [ "$POPULATED" = "t" ] && CONCURRENTLY="CONCURRENTLY"
    PGPASSWORD="{{db_password}}" psql -h "{{db_host}}" -p "{{db_port}}" -U "{{db_user}}" -d be2osm -v ON_ERROR_STOP=1 -c \
        "REFRESH MATERIALIZED VIEW $CONCURRENTLY grb.buildings_with_addresses;"

    END_TIME=$(date +%s)
    DURATION=$((END_TIME - START_TIME))

    # Show final count
    FINAL_COUNT=$(PGPASSWORD="{{db_password}}" psql -h "{{db_host}}" -p "{{db_port}}" -U "{{db_user}}" -d be2osm -t -A -c \
        "SELECT COUNT(*) FROM grb.buildings_with_addresses;")
    echo "✅ Materialized view refreshed: $FINAL_COUNT rows in ${DURATION}s"

# ============================================================================
# INTERNAL TASKS - OSM Differential Updates
# ============================================================================

# OSM: Setup replication configuration for Geofabrik daily diffs
_osm-setup-replication:
    #!/usr/bin/env bash
    echo "📋 Setting up OSM replication..."
    mkdir -p data/osm/imposm-diff

    # Check if last.state.txt exists (indicates previous import)
    if [ ! -f "data/osm/imposm-diff/last.state.txt" ]; then
        echo "⚠️  No previous state found. Running initial import first..."
        echo "   Please run 'just osm-download && just osm-import' first"
        exit 1
    fi
    echo "✅ Replication state found"

# OSM: Run imposm3 diff update
_osm-run-update:
    @echo "🔄 Running imposm3 diff update..."
    imposm run \
        -config config/imposm-config.json \
        -connection "postgis://{{db_user}}:{{db_password}}@{{db_host}}:{{db_port}}/{{osmbe_db}}" \
        -dbschema-import import \
        -expiretiles-dir data/osm/expired-tiles
    @echo "✅ Diff update applied"

# OSM: Initialize replication state from PBF file timestamp
_osm-init-replication:
    #!/usr/bin/env bash
    echo "🔧 Initializing OSM replication state..."
    mkdir -p data/osm/imposm-diff

    # Get the timestamp from the PBF file using osmium
    if command -v osmium &> /dev/null; then
        TIMESTAMP=$(osmium fileinfo -g header.option.osmosis_replication_timestamp "{{osm_file}}" 2>/dev/null || echo "")
        if [ -n "$TIMESTAMP" ]; then
            echo "📅 PBF timestamp: $TIMESTAMP"
            # Create initial state file
            echo "timestamp=$TIMESTAMP" > data/osm/imposm-diff/last.state.txt
            echo "✅ Replication state initialized"
        else
            echo "⚠️  Could not extract timestamp from PBF file"
            echo "   Creating state with current date minus 2 days"
            TIMESTAMP=$(date -u -v-2d +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -d "2 days ago" +%Y-%m-%dT%H:%M:%SZ)
            echo "timestamp=$TIMESTAMP" > data/osm/imposm-diff/last.state.txt
        fi
    else
        echo "⚠️  osmium not installed, using fallback timestamp"
        TIMESTAMP=$(date -u -v-2d +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -d "2 days ago" +%Y-%m-%dT%H:%M:%SZ)
        echo "timestamp=$TIMESTAMP" > data/osm/imposm-diff/last.state.txt
    fi

# ============================================================================
# INTERNAL TASKS - GRB Differential Updates
# ============================================================================

# GRB: start of the next differential order: the day of the last import or update recorded in grb.import_meta
# (it travels with CI restores), else 7 days ago. Overlapping a diff already applied is harmless.
_grb-get-last-update:
    #!/usr/bin/env bash
    LAST=$({{psql_be2osm}} -tAq -c "SELECT to_char(max(imported_at) AT TIME ZONE 'UTC', 'YYYY-MM-DD\"T\"00:00:00\"Z\"') FROM grb.import_meta" 2>/dev/null || true)
    if [ -n "$LAST" ]; then
        echo "$LAST"
    else
        date -u -v-7d +%Y-%m-%dT00:00:00Z 2>/dev/null || date -u -d "7 days ago" +%Y-%m-%dT00:00:00Z
    fi

# GRB: record the update in grb.import_meta (the next differential order starts from it)
_grb-save-last-update:
    @just _save-import-meta grb

# GRB: Create differential order for GBG (buildings) with temporalCrop
_grb-order-diff-gbg:
    #!/usr/bin/env bash
    echo "📦 Ordering GBG differential (Buildings)..."
    mkdir -p {{grb_orders_dir}}

    PRODUCT_ID=6553

    # First, check if product supports difference files
    echo "🔍 Checking if product supports differential files..."
    PRODUCT_INFO=$(curl -s -H "x-api-key: {{grb_api_key}}" "{{grb_api_base}}/products/$PRODUCT_ID")

    ALLOW_DIFF=$(echo "$PRODUCT_INFO" | jq -r '.allowDifferenceFiles // false')
    if [ "$ALLOW_DIFF" != "true" ]; then
        echo "⚠️  Product $PRODUCT_ID does not support differential files (allowDifferenceFiles=$ALLOW_DIFF)"
        echo "   Falling back to full order without temporalCrop..."

        # Create order without temporalCrop
        PAYLOAD='{"productId": '$PRODUCT_ID', "format": "Shapefile"}'
        RESPONSE=$(curl -s -H "x-api-key: {{grb_api_key}}" -H "Content-Type: application/json" \
            -X POST -d "$PAYLOAD" {{grb_api_base}}/orders)
        echo "$RESPONSE" > {{grb_orders_dir}}/gbg-diff_order.json
        ORDER_ID=$(echo "$RESPONSE" | jq -r '.member[0].orderId')

        if [ "$ORDER_ID" = "null" ] || [ -z "$ORDER_ID" ]; then
            echo "❌ Failed to create order. Response:"
            echo "$RESPONSE" | jq .
            exit 1
        fi
        echo "✅ Order ID: $ORDER_ID (full dataset)"
        exit 0
    fi

    # Get allowed date range from product info
    DIFF_MIN_START=$(echo "$PRODUCT_INFO" | jq -r '.DifferenceFileMinStartDate // empty')
    DIFF_MAX_END=$(echo "$PRODUCT_INFO" | jq -r '.DifferenceFileMaxEndDate // empty')

    echo "✅ Product supports differential files"
    [ -n "$DIFF_MIN_START" ] && echo "   Min start date: $DIFF_MIN_START"
    [ -n "$DIFF_MAX_END" ] && echo "   Max end date: $DIFF_MAX_END"

    # Get date range for our request
    FROM_DATE=$(just _grb-get-last-update)
    TO_DATE=$(date -u +%Y-%m-%dT23:59:59Z)

    echo "   Requesting from: $FROM_DATE"
    echo "   Requesting to:   $TO_DATE"

    # Build JSON payload with temporalCrop
    PAYLOAD=$(printf '{"productId": %d, "format": "Shapefile", "temporalCrop": {"from": "%s", "to": "%s"}}' "$PRODUCT_ID" "$FROM_DATE" "$TO_DATE")

    RESPONSE=$(curl -s -H "x-api-key: {{grb_api_key}}" -H "Content-Type: application/json" \
        -X POST -d "$PAYLOAD" {{grb_api_base}}/orders)
    echo "$RESPONSE" > {{grb_orders_dir}}/gbg-diff_order.json
    ORDER_ID=$(echo "$RESPONSE" | jq -r '.member[0].orderId')

    if [ "$ORDER_ID" = "null" ] || [ -z "$ORDER_ID" ]; then
        echo "❌ Failed to create differential order. Response:"
        echo "$RESPONSE" | jq .
        echo ""
        echo "⚠️  Trying fallback to full order..."

        # Fallback to full order
        PAYLOAD='{"productId": '$PRODUCT_ID', "format": "Shapefile"}'
        RESPONSE=$(curl -s -H "x-api-key: {{grb_api_key}}" -H "Content-Type: application/json" \
            -X POST -d "$PAYLOAD" {{grb_api_base}}/orders)
        echo "$RESPONSE" > {{grb_orders_dir}}/gbg-diff_order.json
        ORDER_ID=$(echo "$RESPONSE" | jq -r '.member[0].orderId')

        if [ "$ORDER_ID" = "null" ] || [ -z "$ORDER_ID" ]; then
            echo "❌ Fallback also failed. Response:"
            echo "$RESPONSE" | jq .
            exit 1
        fi
        echo "✅ Order ID: $ORDER_ID (full dataset fallback)"
    else
        echo "✅ Order ID: $ORDER_ID (differential)"
    fi

# GRB: Import differential building polygons (upsert mode)
_grb-import-diff-building-polygons:
    #!/usr/bin/env bash
    # Applies the GBG/GBA difference files (a delete and an add file per entity) with sql/updates/grb-apply-diff.sql,
    # in one transaction. Files are recognised by name: Gbg*/Gba* plus "del" or "add" (case-insensitive). A plain
    # Gbg*.shp (the full dataset, when the product offers no difference files) is applied as adds (upserts).
    set -euo pipefail
    echo "📊 Applying the GRB difference files..."
    DIFF_DIR="{{grb_data_dir}}/gbg-diff"
    PG="PG:host={{db_host}} port={{db_port}} dbname={{be2osm_db}} user={{db_user}} password={{db_password}}"

    if [ ! -d "$DIFF_DIR" ]; then
        echo "⚠️  No differential data found in $DIFF_DIR"
        exit 0
    fi

    {{psql_be2osm}} -q -v ON_ERROR_STOP=1 -c "
        SET client_min_messages = warning;
        DROP TABLE IF EXISTS grb._diff_add, grb._diff_del, grb._diff_load;
        CREATE TABLE grb._diff_del (entity VARCHAR(3) NOT NULL, uidn NUMERIC, oidn NUMERIC);"
    ADD_CREATED=0
    FOUND=0
    while IFS= read -r file; do
        name="$(basename "$file")"
        lower="${name,,}"
        case "$lower" in
        gbg*) entity=Gbg ;;
        gba*) entity=Gba ;;
        *)
            echo "   skipping $name (not GBG/GBA)"
            continue
            ;;
        esac
        FOUND=1
        ogr2ogr -f PostgreSQL "$PG" "$file" -nln grb._diff_load -overwrite -t_srs EPSG:4326 \
            -lco GEOMETRY_NAME=geom -lco SPATIAL_INDEX=NONE -lco FID=ogc_fid
        if [[ "$lower" == *del* ]]; then
            echo "   delete file: $name ($entity)"
            {{psql_be2osm}} -q -v ON_ERROR_STOP=1 -c "INSERT INTO grb._diff_del SELECT '$entity', uidn, oidn FROM grb._diff_load;"
        else
            echo "   add file: $name ($entity)"
            if [ "$ADD_CREATED" = 0 ]; then
                {{psql_be2osm}} -q -v ON_ERROR_STOP=1 -c "CREATE TABLE grb._diff_add AS SELECT '$entity'::varchar(3) AS entity, * FROM grb._diff_load;"
                ADD_CREATED=1
            else
                {{psql_be2osm}} -q -v ON_ERROR_STOP=1 -c "INSERT INTO grb._diff_add SELECT '$entity', * FROM grb._diff_load;"
            fi
        fi
    done < <(find "$DIFF_DIR" -iname '*.shp' -type f | sort)

    if [ "$FOUND" = 0 ]; then
        {{psql_be2osm}} -q -c "DROP TABLE IF EXISTS grb._diff_add, grb._diff_del, grb._diff_load;"
        echo "❌ No Gbg/Gba shapefile in $DIFF_DIR"
        exit 1
    fi
    if [ "$ADD_CREATED" = 0 ]; then
        # Only deletions: an empty add table with the columns the SQL reads
        {{psql_be2osm}} -q -v ON_ERROR_STOP=1 -c "CREATE TABLE grb._diff_add (entity VARCHAR(3), oidn NUMERIC, uidn NUMERIC,
            type NUMERIC, lbltype TEXT, oppervl NUMERIC, lengte NUMERIC, versie NUMERIC, bgninv NUMERIC, lblbgninv TEXT,
            opndatum TEXT, geom geometry(Polygon, 4326));"
    fi
    {{psql_be2osm}} -q -v ON_ERROR_STOP=1 -c "DROP TABLE grb._diff_load;"
    {{psql_be2osm}} -q -f sql/updates/grb-apply-diff.sql

    # Clean up diff download after import
    rm -rf "$DIFF_DIR"
    echo "✅ Difference files applied"

# ============================================================================
# INTERNAL TASKS - PICC Differential Updates
# ============================================================================

# Record in <schema>.import_meta when the data was imported (shown in the app, Issue #59).
# Stored in the database, so it survives the CI dump -> webhook restore flow, and created
# idempotently so existing deployments (init scripts only run on a fresh volume) work too.
_save-import-meta schema:
    #!/usr/bin/env bash
    set -euo pipefail
    {{psql_be2osm}} -v ON_ERROR_STOP=1 <<'SQL'
    CREATE TABLE IF NOT EXISTS {{schema}}.import_meta (imported_at TIMESTAMPTZ NOT NULL);
    DELETE FROM {{schema}}.import_meta;
    INSERT INTO {{schema}}.import_meta (imported_at) VALUES (now());
    SQL
    echo "📅 Recorded {{schema}} import time in {{schema}}.import_meta"

# PICC: Save last update timestamp
_picc-save-last-update:
    @just _save-import-meta picc

# PICC: start of the next ArcGIS update, from picc.import_meta (it travels with CI restores)
_picc-last-update:
    @{{psql_be2osm}} -tAq -c "SELECT to_char(max(imported_at) AT TIME ZONE 'UTC', 'YYYY-MM-DD\"T\"00:00:00\"Z\"') FROM picc.import_meta"

# PICC: Check that a previous import exists
_picc-check-last-update:
    #!/usr/bin/env bash
    LAST_UPDATE=$(just _picc-last-update 2>/dev/null || true)
    if [ -z "$LAST_UPDATE" ]; then
        echo "❌ No previous PICC import found (picc.import_meta is empty)."
        echo "   Run 'just picc-full' or the PICC Import workflow first."
        exit 1
    fi
    echo "📅 Last PICC update: $LAST_UPDATE"

# PICC: Fetch modified buildings from ArcGIS REST API (paginated)
_picc-fetch-diff-buildings:
    #!/usr/bin/env bash
    set -e
    LAST_UPDATE=$(just _picc-last-update)
    WHERE="DATE_MODIF > timestamp '${LAST_UPDATE}'"
    OUTPUT="{{picc_data_dir}}/diff-buildings.geojson"
    mkdir -p {{picc_data_dir}}

    echo "🔍 Querying modified buildings since ${LAST_UPDATE}..."

    OFFSET=0
    PAGE=1
    COMBINED='{"type":"FeatureCollection","features":['
    TOTAL=0

    while true; do
        URL="{{picc_arcgis_base}}/{{picc_arcgis_buildings_layer}}/query"
        RESPONSE=$(curl -sf -G "$URL" \
            --data-urlencode "where=${WHERE}" \
            --data-urlencode "outFields=*" \
            --data-urlencode "f=geojson" \
            --data-urlencode "resultRecordCount={{picc_arcgis_page_size}}" \
            --data-urlencode "resultOffset=${OFFSET}")

        COUNT=$(echo "$RESPONSE" | jq '.features | length')
        if [ "$COUNT" -eq 0 ]; then
            break
        fi

        echo "   Page ${PAGE}: ${COUNT} features (offset ${OFFSET})"
        TOTAL=$((TOTAL + COUNT))

        # Extract features array content
        FEATURES=$(echo "$RESPONSE" | jq -c '.features[]')
        if [ $OFFSET -gt 0 ]; then
            COMBINED="${COMBINED},"
        fi
        COMBINED="${COMBINED}$(echo "$FEATURES" | paste -sd ',' -)"

        OFFSET=$((OFFSET + COUNT))
        PAGE=$((PAGE + 1))

        # If fewer results than page size, we're done
        if [ "$COUNT" -lt {{picc_arcgis_page_size}} ]; then
            break
        fi
    done

    COMBINED="${COMBINED}]}"

    if [ "$TOTAL" -eq 0 ]; then
        echo "   No modified buildings found"
        echo '{"type":"FeatureCollection","features":[]}' > "$OUTPUT"
    else
        echo "$COMBINED" > "$OUTPUT"
        echo "✅ ${TOTAL} modified buildings saved to ${OUTPUT}"
    fi

# PICC: Fetch modified addresses from ArcGIS REST API (paginated)
_picc-fetch-diff-addresses:
    #!/usr/bin/env bash
