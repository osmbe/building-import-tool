    @echo "  picc-download          - Download PICC buildings + ICAR addresses"
    @echo "  picc-import            - Import downloaded data + create matview"
    @echo "  picc-full              - Complete workflow (download + import)"
    @echo "  picc-update            - Update PICC data (diff since last update)"
    @echo "  picc-status            - Show PICC database statistics"
