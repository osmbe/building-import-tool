        -nln picc.staging_addresses \
        -overwrite \
        -lco GEOMETRY_NAME=geom \
        -lco SPATIAL_INDEX=NONE \
        -lco PRECISION=NO \
        -dim 2 \
        -t_srs EPSG:31370 \
        -gt 100000 --config PG_USE_COPY YES

    # Delete matching records from main table, then insert from staging
    {{psql_be2osm}} -c "
        DELETE FROM picc.icar_adr_pt
        WHERE objectid IN (SELECT objectid FROM picc.staging_addresses);

        INSERT INTO picc.icar_adr_pt
