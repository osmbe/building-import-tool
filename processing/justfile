# Complete GRB workflow: order → wait → download → import
grb-full:
    @echo "🚀 Complete GRB Import Workflow"
    @echo "========================================"
    @just grb-order-all
    @just _grb-wait-for-orders
    @just grb-download-all
    @just grb-import

# Targeted patch: re-download Addresses product and re-import only address-building links.
# Use when address_building_links needs repopulating without a full re-import.
grb-patch-address-links:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p {{grb_orders_dir}}
    echo "📦 Ordering Addresses product (contains RltAdresGebouw link files)..."
    RESPONSE=$(curl -s -H "x-api-key: {{grb_api_key}}" -H "Content-Type: application/json" \
        -X POST -d '{"productId": 10445, "format": "Shapefile"}' {{grb_api_base}}/orders)
    ORDER_ID=$(echo "$RESPONSE" | jq -r '.member[0].orderId')
    echo "✅ Order ID: $ORDER_ID"
    echo "⏳ Waiting for order to be processed..."
    while true; do
        STATUS=$(curl -s --retry 5 --retry-all-errors --retry-delay 10 \
            -H "x-api-key: {{grb_api_key}}" {{grb_api_base}}/orders/$ORDER_ID | jq -r '.status')
        echo "$(date +%H:%M:%S) - addresses: $STATUS"
        if [ "$STATUS" = "Processed" ] || [ "$STATUS" = "Completed" ]; then
            break
        fi
        sleep 60
    done
    just _grb-download-if-ready addresses $ORDER_ID
    just _grb-import-address-links
    echo "✅ Address-building links patched!"

