# ============================================================================
# REMOTE IMPORT TASKS - GitHub Actions (heavy processing on free runners)
# ============================================================================

# GitHub repository for remote workflows
gh_repo := env_var_or_default('GH_REPO', 'osmbe/building-import-tool')

# Trigger OSM import on GitHub Actions, wait, download and restore locally
osm-import-remote:
    #!/usr/bin/env bash
    set -e
    echo "🚀 Remote OSM Import via GitHub Actions"
    echo "========================================"
    echo ""

    # Check prerequisites
    if ! command -v gh &> /dev/null; then
        echo "❌ GitHub CLI (gh) is not installed"
        echo "   Install: https://cli.github.com/"
        exit 1
    fi

    # Trigger the workflow
    echo "📤 Triggering OSM Import workflow..."
    gh workflow run osm-import.yml -R "{{gh_repo}}"

    # Wait for run to be created
    sleep 5

    # Get the run ID
    RUN_ID=$(gh run list -R "{{gh_repo}}" -w "OSM Import" --limit 1 --json databaseId -q '.[0].databaseId')
    echo "📋 Workflow run ID: $RUN_ID"
    echo ""

    # Watch the run (blocks until complete)
    echo "⏳ Waiting for workflow to complete..."
    echo "   (This may take 30-60 minutes for Belgium OSM data)"
    echo ""
    gh run watch "$RUN_ID" -R "{{gh_repo}}"

    # Check if successful
    STATUS=$(gh run view "$RUN_ID" -R "{{gh_repo}}" --json conclusion -q '.conclusion')
    if [ "$STATUS" != "success" ]; then
        echo ""
        echo "❌ Workflow failed with status: $STATUS"
        echo "   View logs: gh run view $RUN_ID -R {{gh_repo}} --log"
        exit 1
    fi

    # Download the artifact
    echo ""
    echo "📥 Downloading OSM dump artifact..."
    rm -rf /tmp/osm-restore
    mkdir -p /tmp/osm-restore
    gh run download "$RUN_ID" -R "{{gh_repo}}" -n osmbe-dump -D /tmp/osm-restore

    # Show artifact size
    ls -lh /tmp/osm-restore/osmbe.sql.gz

    # Clear existing data before restore (data-only dump covers the full osm schema)
    echo ""
    echo "🧹 Clearing existing OSM data..."
    {{psql_osmbe}} -c "TRUNCATE osm.osm_buildings CASCADE;" || true
    {{psql_osmbe}} -c "TRUNCATE osm.osm_addresses CASCADE;" || true

    # Restore to local database
    echo ""
    echo "🔄 Restoring to local database..."
    gunzip -c /tmp/osm-restore/osmbe.sql.gz | {{psql_osmbe}}

    # Post-restore: update statistics
    echo ""
    echo "📊 Updating database statistics..."
    {{psql_osmbe}} -c "ANALYZE osm.osm_buildings; ANALYZE osm.osm_addresses;"

    # Cleanup
    rm -rf /tmp/osm-restore

    echo ""
    echo "✅ Remote OSM Import Complete!"
    echo ""
    just osm-status

# Trigger GRB import on GitHub Actions, wait, download and restore locally
grb-import-remote:
    #!/usr/bin/env bash
    set -e
    echo "🚀 Remote GRB Import via GitHub Actions"
    echo "========================================"
    echo ""

    # Check prerequisites
    if ! command -v gh &> /dev/null; then
        echo "❌ GitHub CLI (gh) is not installed"
        echo "   Install: https://cli.github.com/"
        exit 1
    fi

    # Trigger the workflow
    echo "📤 Triggering GRB Import workflow..."
    gh workflow run grb-import.yml -R "{{gh_repo}}"

    # Wait for run to be created
    sleep 5

    # Get the run ID
    RUN_ID=$(gh run list -R "{{gh_repo}}" -w "GRB Import" --limit 1 --json databaseId -q '.[0].databaseId')
    echo "📋 Workflow run ID: $RUN_ID"
    echo ""

    # Watch the run (blocks until complete)
    echo "⏳ Waiting for workflow to complete..."
    echo "   (This may take 1-2 hours for full GRB dataset)"
    echo ""
    gh run watch "$RUN_ID" -R "{{gh_repo}}"

    # Check if successful
    STATUS=$(gh run view "$RUN_ID" -R "{{gh_repo}}" --json conclusion -q '.conclusion')
    if [ "$STATUS" != "success" ]; then
        echo ""
        echo "❌ Workflow failed with status: $STATUS"
        echo "   View logs: gh run view $RUN_ID -R {{gh_repo}} --log"
        exit 1
    fi

    # Download the artifact
    echo ""
    echo "📥 Downloading GRB dump artifact..."
    rm -rf /tmp/grb-restore
    mkdir -p /tmp/grb-restore
    gh run download "$RUN_ID" -R "{{gh_repo}}" -n be2osm-dump -D /tmp/grb-restore

    # Show artifact size
    ls -lh /tmp/grb-restore/be2osm.sql.gz

    # Clear existing data before restore (data-only dump)
    echo ""
    echo "🧹 Clearing existing GRB data..."
    {{psql_be2osm}} -c "TRUNCATE grb.building_polygons, grb.buildings, grb.addresses, grb.address_building_links CASCADE;" || true
    {{psql_be2osm}} -c "TRUNCATE grb.kunstwerken CASCADE;" 2>/dev/null || true

    # The data-only dump expects the current schema (e.g. building_polygons.entity). Migrating on the
    # emptied tables is instant.
    just db-migrate

    # Restore to local database
    echo ""
    echo "🔄 Restoring to local database..."
    gunzip -c /tmp/grb-restore/be2osm.sql.gz | {{psql_be2osm}}

    # Post-restore: update statistics (skip mat view refresh for speed)
    echo ""
    echo "📊 Updating database statistics..."
    {{psql_be2osm}} -c "ANALYZE grb.building_polygons, grb.buildings, grb.addresses, grb.address_building_links;"
    {{psql_be2osm}} -c "ANALYZE grb.kunstwerken;" 2>/dev/null || true

    # Cleanup
    rm -rf /tmp/grb-restore

    echo ""
    echo "✅ Remote GRB Import Complete!"
    echo ""
    just grb-status
    echo ""
    echo "⚠️  Note: Materialized view not refreshed (takes 20-30 min)"
    echo "   Tiles will work without it, but refresh improves performance."
    echo "   Run when ready: just grb-refresh-view"

# Refresh GRB materialized view (slow - run separately)
grb-refresh-view:
    @echo "📊 Refreshing GRB materialized view..."
    @echo "   This joins 5M+ building polygons with addresses"
    @echo "   Expected time: 20-30 minutes on 4GB VPS"
    @echo ""
    @just _grb-refresh-materialized-view

# Trigger PICC import on GitHub Actions, wait, download and restore locally
picc-import-remote:
    #!/usr/bin/env bash
    set -e
    echo "🚀 Remote PICC Import via GitHub Actions"
    echo "========================================"
    echo ""

    # Check prerequisites
    if ! command -v gh &> /dev/null; then
        echo "❌ GitHub CLI (gh) is not installed"
        echo "   Install: https://cli.github.com/"
        exit 1
    fi

    # Trigger the workflow
    echo "📤 Triggering PICC Import workflow..."
    gh workflow run picc-import.yml -R "{{gh_repo}}"

    # Wait for run to be created
    sleep 5

    # Get the run ID
    RUN_ID=$(gh run list -R "{{gh_repo}}" -w "PICC Import" --limit 1 --json databaseId -q '.[0].databaseId')
    echo "📋 Workflow run ID: $RUN_ID"
    echo ""

    # Watch the run (blocks until complete)
    echo "⏳ Waiting for workflow to complete..."
    echo "   (This may take 20-40 minutes for Wallonia data)"
    echo ""
    gh run watch "$RUN_ID" -R "{{gh_repo}}"

    # Check if successful
    STATUS=$(gh run view "$RUN_ID" -R "{{gh_repo}}" --json conclusion -q '.conclusion')
    if [ "$STATUS" != "success" ]; then
        echo ""
        echo "❌ Workflow failed with status: $STATUS"
        echo "   View logs: gh run view $RUN_ID -R {{gh_repo}} --log"
        exit 1
    fi

    # Download the artifact
    echo ""
    echo "📥 Downloading PICC dump artifact..."
    rm -rf /tmp/picc-restore
    mkdir -p /tmp/picc-restore
    gh run download "$RUN_ID" -R "{{gh_repo}}" -n picc-dump -D /tmp/picc-restore

    # Show artifact size
    ls -lh /tmp/picc-restore/picc.sql.gz

    # Restore next to the live schema and swap (sql dump of picc_next, see scripts/publish-schema.sh)
    echo ""
    PGHOST='{{db_host}}' PGPORT='{{db_port}}' PGUSER='{{db_user}}' PGDATABASE='{{be2osm_db}}' \
        bash scripts/publish-schema.sh picc /tmp/picc-restore/picc.sql.gz

    # Cleanup
    rm -rf /tmp/picc-restore

    echo ""
    echo "✅ Remote PICC Import Complete!"
    echo ""
    just picc-status

