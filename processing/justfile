    #!/usr/bin/env bash
    echo "📦 Ordering KNW (Kunstwerken)..."
    PRODUCT_ID="${GRB_KNW_PRODUCT_ID:-6555}"
    RESPONSE=$(curl -s -H "x-api-key: {{grb_api_key}}" -H "Content-Type: application/json" \
        -X POST -d "{\"productId\": ${PRODUCT_ID}, \"format\": \"Shapefile\"}" {{grb_api_base}}/orders)
    echo "$RESPONSE" > {{grb_orders_dir}}/knw_order.json
    ORDER_ID=$(echo "$RESPONSE" | jq -r '.member[0].orderId')
    if [ -z "$ORDER_ID" ] || [ "$ORDER_ID" = "null" ]; then
        echo "❌ Failed to create KNW order using productId ${PRODUCT_ID}"
        echo "$RESPONSE" | jq .
        exit 1
    fi
    echo "✅ Order ID: $ORDER_ID (productId=${PRODUCT_ID})"

