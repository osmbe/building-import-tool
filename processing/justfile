# PICC: apply the fetched changes: the buildings and addresses with the objectids of the changed ones are
# replaced (picc.load_raw with replace), in one transaction
_picc-apply-diff:
    #!/usr/bin/env bash
    set -euo pipefail
    B="{{picc_data_dir}}/diff-buildings.geojson"
    A="{{picc_data_dir}}/diff-addresses.geojson"
    {{psql_be2osm}} -q -c "SET client_min_messages = warning; DROP TABLE IF EXISTS picc._raw_update_buildings, picc._raw_update_addresses;"
    for pair in "$B:picc._raw_update_buildings" "$A:picc._raw_update_addresses"; do
        file="${pair%%:*}"
        if [ -f "$file" ] && [ "$(jq '.features | length' "$file")" -gt 0 ]; then
            echo "📊 Loading $(jq '.features | length' "$file") changes from $(basename "$file")..."
            ogr2ogr -f PostgreSQL \
                "PG:host={{db_host}} port={{db_port}} dbname={{be2osm_db}} user={{db_user}} password={{db_password}}" \
                "$file" -nln "${pair#*:}" -overwrite -nlt PROMOTE_TO_MULTI -dim 2 -t_srs EPSG:31370 \
                -lco GEOMETRY_NAME=geom -lco SPATIAL_INDEX=NONE -lco PRECISION=NO
        fi
    done
    {{psql_be2osm}} -X -q -v ON_ERROR_STOP=1 <<'SQL'
    SET client_min_messages = warning;
    BEGIN;
    SELECT format('   replaced %s buildings, %s addresses', buildings, addresses) AS applied
    FROM picc.load_raw(to_regclass('picc._raw_update_buildings'), to_regclass('picc._raw_update_addresses'), true) \gset
    \echo :applied
    DROP TABLE IF EXISTS picc._raw_update_buildings, picc._raw_update_addresses;
    COMMIT;
    SQL
    rm -f "$B" "$A"
    echo "✅ PICC changes applied"

