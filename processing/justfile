# PICC: Refresh materialized view after update
_picc-refresh-matview:
    #!/usr/bin/env bash
    set -e
    echo "🔄 Refreshing PICC materialized view..."
    {{psql_be2osm}} -c "REFRESH MATERIALIZED VIEW CONCURRENTLY picc.buildings_with_addresses;"
    echo "✅ Materialized view refreshed"
