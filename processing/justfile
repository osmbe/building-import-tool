# Order all GRB datasets from Digital Vlaanderen API
grb-order-all:
    @echo "📦 Creating orders for all GRB products..."
    @mkdir -p {{grb_orders_dir}}
    @echo ""
    @just _grb-order-gbg
    @just _grb-order-gba
    @just _grb-order-knw
    @just _grb-order-addresses
    @echo ""
    @echo "✅ All orders created!"
    @echo ""
    @echo "Note: RltGbgGebouw*.dbf (polygon-building relationships) and RltAdresGebouw*.dbf (address links) are both included in their respective downloads"
    @echo "Check status with: just grb-status-orders"

# Download all ready GRB orders
# Use GRB_DOWNLOAD_PARALLEL=0 to force sequential mode (recommended in CI)
grb-download-all:
    #!/usr/bin/env bash
    echo "📥 Downloading all ready orders..."
    echo "   parallel={{grb_download_parallel}}, max_attempts={{grb_download_max_attempts}}, max_time={{grb_download_max_time_sec}}s, retry_sleep={{grb_download_retry_sleep_sec}}s"
    echo ""

    if [ "{{grb_download_parallel}}" = "1" ]; then
        just _grb-download-if-ready gbg "$(just _grb-get-order-id gbg)" &
        PID_GBG=$!
        just _grb-download-if-ready gba "$(just _grb-get-order-id gba)" &
        PID_GBA=$!
        just _grb-download-if-ready knw "$(just _grb-get-order-id knw)" &
        PID_KNW=$!
        just _grb-download-if-ready addresses "$(just _grb-get-order-id addresses)" &
        PID_ADDR=$!
        wait $PID_GBG; EXIT_GBG=$?
        wait $PID_GBA; EXIT_GBA=$?
        wait $PID_KNW; EXIT_KNW=$?
        wait $PID_ADDR; EXIT_ADDR=$?
        if [ $EXIT_GBG -ne 0 ] || [ $EXIT_GBA -ne 0 ] || [ $EXIT_KNW -ne 0 ] || [ $EXIT_ADDR -ne 0 ]; then
            echo "❌ One or more downloads failed" >&2
            exit 1
        fi
    else
        EXIT_CODE=0
        for PRODUCT in gbg gba knw addresses; do
            ORDER_ID=$(just _grb-get-order-id "$PRODUCT")
            if ! just _grb-download-if-ready "$PRODUCT" "$ORDER_ID"; then
                EXIT_CODE=1
            fi
        done
        if [ $EXIT_CODE -ne 0 ]; then
            echo "❌ One or more downloads failed" >&2
            exit 1
        fi
    fi
    echo ""
    echo "✅ All downloads complete!"

# Download one GRB product from an existing order file (gbg/gba/knw/addresses)
grb-download-product product:
    #!/usr/bin/env bash
    ORDER_ID=$(just _grb-get-order-id "{{product}}")
    if [ -z "$ORDER_ID" ] || [ "$ORDER_ID" = "null" ]; then
        echo "❌ No saved order ID found for {{product}} in {{grb_orders_dir}}" >&2
        echo "   Run: just grb-order-all" >&2
        exit 1
    fi
    just _grb-download-if-ready "{{product}}" "$ORDER_ID"

# Download selected GRB products (comma-separated: gbg,gba,knw,addresses)
# Creates missing orders for requested products, waits for readiness, then downloads only those.
grb-download-selected products:
    #!/usr/bin/env bash
    set -euo pipefail

    INPUT="{{products}}"
    if [ -z "$INPUT" ] || [ "$INPUT" = "all" ]; then
        INPUT="gbg,gba,knw,addresses"
    fi

    IFS=',' read -r -a PRODUCT_LIST <<< "$INPUT"
    mkdir -p {{grb_orders_dir}}

    echo "📦 Preparing selected products: $INPUT"
    for RAW in "${PRODUCT_LIST[@]}"; do
        PRODUCT=$(echo "$RAW" | tr -d '[:space:]')
        case "$PRODUCT" in
            gbg|gba|knw|addresses) ;;
            *)
                echo "❌ Invalid product: $PRODUCT (allowed: gbg,gba,knw,addresses)" >&2
                exit 1
                ;;
        esac

        ORDER_ID=$(just _grb-get-order-id "$PRODUCT")
        if [ -z "$ORDER_ID" ] || [ "$ORDER_ID" = "null" ]; then
            just _grb-order-"$PRODUCT"
            ORDER_ID=$(just _grb-get-order-id "$PRODUCT")
            if [ -z "$ORDER_ID" ] || [ "$ORDER_ID" = "null" ]; then
                echo "❌ Failed to create order for $PRODUCT" >&2
                exit 1
            fi
        else
            echo "✅ Reusing existing order for $PRODUCT: $ORDER_ID"
        fi
    done

    echo ""
    echo "⏳ Waiting for selected orders to be processed..."
    while true; do
        ALL_READY=true
        for RAW in "${PRODUCT_LIST[@]}"; do
            PRODUCT=$(echo "$RAW" | tr -d '[:space:]')
            ORDER_ID=$(just _grb-get-order-id "$PRODUCT")
            STATUS=$(curl -s --retry 5 --retry-all-errors --retry-delay 10 \
                -H "x-api-key: {{grb_api_key}}" {{grb_api_base}}/orders/$ORDER_ID | jq -r '.status')
            echo "$(date +%H:%M:%S) - $PRODUCT: $STATUS"
            if [ "$STATUS" != "Processed" ] && [ "$STATUS" != "Completed" ]; then
                ALL_READY=false
            fi
        done
        echo ""
        if [ "$ALL_READY" = true ]; then
            echo "✅ All selected orders ready!"
            break
        fi
        sleep 60
    done

    echo "📥 Downloading selected products..."
    EXIT_CODE=0
    for RAW in "${PRODUCT_LIST[@]}"; do
        PRODUCT=$(echo "$RAW" | tr -d '[:space:]')
        ORDER_ID=$(just _grb-get-order-id "$PRODUCT")
        if ! just _grb-download-if-ready "$PRODUCT" "$ORDER_ID"; then
            EXIT_CODE=1
        fi
    done

    if [ $EXIT_CODE -ne 0 ]; then
        echo "❌ One or more selected downloads failed" >&2
        exit 1
    fi

    echo "✅ Selected downloads complete"

