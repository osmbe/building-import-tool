    @mkdir -p {{cache_dir}}
    imposm import -mapping {{mapping_file}} -read {{osm_file}} -cachedir {{cache_dir}} -overwritecache

# OSM: imposm3 write step
_osm-imposm-write:
    @echo ""
    @echo "2️⃣  Writing to database (import schema)..."
    imposm import -mapping {{mapping_file}} -connection "postgis://{{db_user}}:{{db_password}}@{{db_host}}:{{db_port}}/{{osmbe_db}}" -write -cachedir {{cache_dir}} -dbschema-import import

