# PICC: Upsert buildings from diff GeoJSON into main table
_picc-upsert-buildings:
    #!/usr/bin/env bash
    set -e
    INPUT="{{picc_data_dir}}/diff-buildings.geojson"
    if [ ! -f "$INPUT" ]; then
        echo "⚠️  No diff buildings file found, skipping"
        return 0
    fi

    COUNT=$(jq '.features | length' "$INPUT")
    if [ "$COUNT" -eq 0 ]; then
        echo "📊 No building changes to apply"
        rm -f "$INPUT"
        return 0
    fi

    echo "📊 Upserting ${COUNT} modified buildings..."

    # Import to staging table
    ogr2ogr -f PostgreSQL \
        "PG:host={{db_host}} port={{db_port}} dbname={{be2osm_db}} user={{db_user}} password={{db_password}}" \
        "$INPUT" \
        -nln picc.staging_buildings \
        -nlt PROMOTE_TO_MULTI \
        -overwrite \
        -lco GEOMETRY_NAME=geom \
        -lco SPATIAL_INDEX=NONE \
        -dim 2 \
        -t_srs EPSG:31370 \
        -gt 100000 --config PG_USE_COPY YES

    # Delete matching records from main table, then insert from staging
    {{psql_be2osm}} -c "
        DELETE FROM picc.constr_batiemprise
        WHERE objectid IN (SELECT objectid FROM picc.staging_buildings);

        INSERT INTO picc.constr_batiemprise
        SELECT * FROM picc.staging_buildings;

        DROP TABLE IF EXISTS picc.staging_buildings;
    "

    rm -f "$INPUT"
    echo "✅ Buildings upserted"

# PICC: Upsert addresses from diff GeoJSON into main table
_picc-upsert-addresses:
    #!/usr/bin/env bash
    set -e
    INPUT="{{picc_data_dir}}/diff-addresses.geojson"
